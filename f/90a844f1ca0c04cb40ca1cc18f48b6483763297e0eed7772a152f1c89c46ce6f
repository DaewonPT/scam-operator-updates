/* ---------- 4) GANHOS OFFLINE ----------
   Quando o jogo está fechado (ou a app em segundo plano) a empresa continua a render, mas ao OFF_RATE do ritmo normal e só até OFF_CAP s de ausência
   (rendimento passivo + lavagem; sem cliques, sem notícias, sem crises, sem mercado crypto). O tempo contado para a classificação é o mesmo
   (S.pt += segundos efetivos), por isso estar fora nunca dá vantagem no tempo. A atenção da polícia nunca ultrapassa OFF_HEAT por estar ausente. */
var OFF_RATE=.5;const OFF_CAP=7200,OFF_MIN=20,OFF_MODAL=120,OFF_HEAT=85;
let LT=Date.now();
const offAway=sd=>sd>0?Math.max(0,(Date.now()-sd)/1000):0;   /* sd = S.ls (último instante em que o jogo andou) ou, nas gravações antigas, S.saveDate */
function offCredit(real){
 if(!S.go||end()||S.dead||!(real>=OFF_MIN))return null;
 const sec=Math.min(real,OFF_CAP),eff=Math.round(sec*OFF_RATE);if(eff<1)return null;
 const c0=cn;cn=null;const tot0=S.tot,lw0=S.lw||0,N=Math.min(120,eff),dt=eff/N;let h=S.h;
 try{for(let i=0;i<N;i++){earn(auto()*dt);launder(dt);passiveTick(dt);S.cl=Math.min(S.cl||0,S.m);h=Math.max(0,h+(passHeat()-decay())*dt)}}finally{cn=c0}
 if(h>S.h)h=Math.min(h,Math.max(S.h,OFF_HEAT));S.h=Math.max(0,h);
 S.pt=(S.pt||0)+eff;S.nb3=(S.nb3||0)+eff;S.nb6=(S.nb6||0)+eff;S.off=(S.off||0)+sec;
 return{real,sec,eff,gain:Math.max(0,S.tot-tot0),wash:Math.max(0,(S.lw||0)-lw0),capped:real>OFF_CAP}}
function offBack(real){
 LT=Date.now();const r=offCredit(real);S.ls=LT;if(!r)return null;
 const txt=t("off_b",{a:fmtT(r.real),p:Math.round(OFF_RATE*100),e:"+"+eur(r.gain),l:eur(r.wash),h:Math.round(S.h),c:fmtT(r.eff)})+(r.capped?"\n"+t("off_cap",{m:fmtT(OFF_CAP)}):"");
 if(r.real>=OFF_MODAL)infoShow("💤 "+t("off_t"),txt);else toast("💤 "+t("off_toast",{a:fmtT(r.real),e:"+"+eur(r.gain)}),4500);
 ui();saveNow();return r}

