 for(let i=a;i<b;i++){const u=alCnt()>i,x=SX[i]||{};
  h+=`<div class="it" style="opacity:${u?1:.6}"><span style="font-size:26px">${u?IC("st"+i,ST[i].ic,"l"):"🔒"}</span><div style="flex:1;min-width:0"><b>${u?esc(x.n||""):"???"}</b><small>${u?esc(x.s||""):t("al_lock",{n:i+1})}</small>${u?`<small>${t("flag")}: ${esc(x.t||"")}</small>`:""}</div></div>`}
 h+=S.alp[p]?`<p class="small gd" style="margin:6px 0 0">${t("al_done")}</p>`:`<p style="margin:6px 0 0"><button style="width:100%" ${full?"":"disabled"} onclick="alClaim(${p})">${t("al_claim")}</button></p>`;
 return h+`</div></div><button style="width:100%;margin-bottom:10px" onclick="hubOpen()">${t("back")}</button>`}
function alOpen(){sfx(700);openPage("al",alHTML())}
function alRefresh(){if(pgMode=="al")openPage("al",alHTML())}
function alClaim(p){if(S.alp[p]||alCnt()<Math.min(stN(),AL_N*(p+1)))return;S.alp[p]=1;S.ct=(S.ct||0)+1;sfx(950);toast(t("al_got",{n:p+1}),4500);alRefresh();ui()}

/* ---------- 7) TREINO ANTI-BURLA — rondas de TR_N perguntas; cada TR_STEP respostas certas = +1 % de ganhos (máx. +10 %, em todos os saves);
   só contam TR_CAP respostas por dia; ronda perfeita (1×/dia) = 1 raspadinha ---------- */
const TR_N=5,TR_CAP=15,TR_STEP=10,TR_MAX=.1;
let TRS=null;
const trBonus=()=>Math.min(TR_MAX,Math.floor((meta().tc||0)/TR_STEP)/100);
function trDay(){const r=meta().tr;if(r.d!==dayN()){r.d=dayN();r.a=0;r.pf=0}return r}
function trNew(){const Q=t("trq")||[];if(Q.length<TR_N)return;const m=meta(),last=m.tr.l||[];
 let pool=Q.map((_,i)=>i).filter(i=>!last.includes(i));if(pool.length<TR_N)pool=Q.map((_,i)=>i);
 const q=scrShuf(pool).slice(0,TR_N);m.tr.l=q.slice();TRS={q,n:0,ok:0,cnt:0,o:scrShuf([0,1,2]),sel:-1,done:0};metaSoon()}
function trOpen(){sfx(700);TRS=null;openPage("tr",trHTML())}
function trStart(){trNew();openPage("tr",trHTML())}
function trPick(k){const T=TRS;if(!T||T.sel>=0||T.done)return;const r=trDay(),right=T.o[k]===0,counted=r.a<TR_CAP;T.sel=k;if(counted)r.a++;
 if(right){T.ok++;if(counted){meta().tc++;T.cnt++}}
 sfx(right?900:180);metaSoon();openPage("tr",trHTML())}
function trNext(){const T=TRS;if(!T||T.sel<0)return;T.n++;T.sel=-1;T.o=scrShuf([0,1,2]);
 if(T.n>=TR_N){T.done=1;const r=trDay();T.perf=0;if(T.ok==TR_N&&!r.pf&&T.cnt>0){r.pf=1;meta().tk++;T.perf=1}mq("train");metaSave();ui()}
 openPage("tr",trHTML())}
function trHTML(){const m=meta(),r=trDay(),T=TRS,Q=t("trq")||[],b=Math.round(trBonus()*100);
 let h=`<div class="w"><div class="tb"><span>🎓 ${t("tr_t")}</span><span class="x" onclick="closePage()">✖</span></div><div class="b">`;
 const foot=`<div class="small" style="margin-top:6px">${t("tr_bonus",{p:b,n:m.tc||0})}${r.a>=TR_CAP?"<br>"+t("tr_cap",{n:TR_CAP}):""}</div>`;
 if(!T){h+=`<div class="row" style="margin-bottom:6px"><span class="small" style="flex:1">${t("tr_intro",{n:TR_N})}</span>${ib("tr")}</div><p><button style="width:100%;font-weight:700" onclick="trStart()">▶ ${t("tr_go")}</button></p>`+foot}
 else if(T.done){h+=`<p><b>${t("tr_end",{c:T.ok,m:TR_N})}</b></p>`+(T.perf?`<p class="gd">${t("tr_perf")}</p>`:"")+foot+`<p><button style="width:100%" onclick="trStart()">${t("tr_again")}</button></p>`}
 else{const q=Q[T.q[T.n]]||Q[0];h+=`<div class="small" style="margin-bottom:4px">${t("tr_q",{n:T.n+1,m:TR_N})}${r.a>=TR_CAP?" · "+t("tr_free"):""}</div><p style="margin:0 0 8px"><b>${esc(q.q)}</b></p>`;
  T.o.forEach((oi,k)=>{const sel=T.sel>=0,right=oi===0,pick=T.sel===k;h+=`<button style="display:block;width:100%;margin-bottom:5px;text-align:left;${sel?(right?"border-color:var(--ok);":pick?"border-color:var(--bad);":"opacity:.6;"):""}" ${sel?"disabled":""} onclick="trPick(${k})">${sel?(right?"✅ ":pick?"❌ ":""):""}${esc(q.o[oi])}</button>`});
  if(T.sel>=0){h+=`<div class="tip">${T.o[T.sel]===0?t("tr_ok"):t("tr_bad")} ${esc(q.e)}</div><p><button style="width:100%;font-weight:700" onclick="trNext()">${T.n+1>=TR_N?t("tr_fin"):t("tr_next")} ▶</button></p>`}}
 return h+`</div></div><button style="width:100%;margin-bottom:10px" onclick="hubOpen()">${t("back")}</button>`}

/* ---------- 8) EQUIPA (subordinados) — aba Equipamento, a partir da fase TM_ST+1; até TM_MAX de cada função ----------
   0 Operador: +TM_INC de ganhos automáticos cada · 1 Mula: +TM_LB de capacidade de lavagem cada · 2 Advogado: −TM_LAW na perda ao seres apanhado (35 %→15 % no mínimo).
   Cada membro dá TM_HEAT de atenção por segundo. Preço do 1.º = TM_C × custo da fase seguinte; cada um seguinte ×TM_G.
   Crises de equipa: com 2+ membros, 1 em cada TM_CR crises (a pior opção faz um membro desertar). A equipa perde-se ao fugir (prestígio). */
const TM_ST=3,TM_MAX=5,TM_C=[.04,.03,.05],TM_G=1.75,TM_INC=.04,TM_LB=.08,TM_LAW=.04,TM_HEAT=.04,TM_CR=.18,TM_IC=["🧑‍💻","🐴","🧑‍⚖️"];
const tmOn=()=>S.st>=TM_ST&&!end();
const tmN=r=>(S.tm&&S.tm[r])|0,tmAll=()=>tmN(0)+tmN(1)+tmN(2);
const tmHeat=()=>tmHt(),lbTm=()=>(1+TM_LB*tmPw(1))*psLb();
const bustPct=()=>Math.max(.15,(S.hc?HC_BUST:S.ez?EZ_BUST:.35)-TM_LAW*tmPw(2)-svLaw()-psBust()-colAdd("u"));
const tmBase=()=>S.st+1<stN()?stCost(S.st+1):paceSig(ST[S.st].cost*paceF())*8;
const tmPrice=r=>Math.ceil(tmBase()*TM_C[r]*Math.pow(TM_G,tmN(r)));
function tmBuy(r){if(!tmOn()||tmN(r)>=TM_MAX)return;const c=tmPrice(r);if(S.m<c)return;S.m-=c;S.cl=Math.min(S.cl||0,S.m);S.tm[r]=tmN(r)+1;mq("buy");sfx(700);ui()}
function tmLose(){const o=[0,1,2].filter(r=>tmN(r)>0);if(!o.length)return -1;const r=o.reduce((a,b)=>tmN(b)>tmN(a)?b:a);S.tm[r]--;return r}
function tmHTML(){if(end())return"";if(!tmOn())return `<div class="w"><div class="tb"><span>🧑‍💼 ${t("tm_t")}</span><span>🔒</span></div><div class="b"><div class="small">${t("tm_lock",{n:TM_ST+1})}</div></div></div>`;
 const N=t("tm_n"),Dd=t("tm_d"),v=[Math.round(TM_INC*100),Math.round(TM_LB*100),Math.round(TM_LAW*100)];
 return `<div class="w"><div class="tb"><span>🧑‍💼 ${t("tm_t")} ${ib("tm")}</span><span>${tmAll()}/${3*TM_MAX}</span></div><div class="b">`+N.map((n,r)=>{const k=tmN(r),c=tmPrice(r);return `<div class="it"><span style="font-size:24px">${TM_IC[r]}</span><div style="flex:1;min-width:0"><b>${n}</b> (x${k}/${TM_MAX})<small>${Dd[r].replace("{v}",v[r])}</small></div>`+(k>=TM_MAX?`<span class="gd" style="flex:0 0 auto">${t("mx")}</span>`:`<button style="flex:0 0 auto" ${S.m>=c?"":"disabled"} onclick="tmBuy(${r})">${t("tm_b",{c:eur(c)})}</button>`)+`</div>`}).join("")+`<div class="small" style="margin-top:4px">${t("tm_now",{a:Math.round(TM_INC*100*tmN(0)),l:Math.round(TM_LB*100*tmN(1)),b:Math.round(bustPct()*100),h:nf(tmHeat(),2)})}</div></div></div>`}
function teamHTML(){return tmHTML()}

/* ---------- 9) MODO HARDCORE — escolhido ao começar um novo jogo (v4.5) ----------
   3 apreensões (atenção a 100 %) = preso: fim da run. Cada apreensão tira HC_BUST do dinheiro sujo (em vez de 35 %), as crises dão metade do tempo,
   um suborno falhado dá +HC_BRIBE_H de atenção. Pontuação (dinheiro) ×HC_MULT. Só entra na classificação (local e global, com 💀 no nome) quem GANHA a run: morrer não regista nada. */
const HC_STRIKES=3,HC_BUST=.6,HC_BRIBE_H=10,HC_MULT=1.5,HC_CR=.5;
const crTime=()=>CR_TIME*(S.hc?HC_CR:1);
function hcStrike(){S.hs=(S.hs||0)+1;if(S.hs>=HC_STRIKES){hcDead();return true}return false}
function hcDead(){if(S.dead)return;S.dead=1;S.h=100;sfx(100);if(CR){clearInterval(CR.i);CR=null;$("cr").style.display="none"}if(CH)closeChat();saveNow();ui()}
function deadHTML(){const e=finEntry();return `<div class="w"><div class="tb"><span>${t("hc_dead_t")}</span><span>💀</span></div><div class="b"><p>${t(S.won?"hc_dead_w":"hc_dead_b",{n:HC_STRIKES})}</p><div class="tip" style="background:var(--in);color:var(--fg)"><b>${t("lb_score")}</b><br>👤 ${esc(rkNm(e))}<br>💰 ${eur(e.m)} · ⏱️ ${fmtT(e.t)}</div><p><button style="width:100%" onclick="rkPage(1)">${t("lbt")}</button></p><p><button style="width:100%" onclick="home()">☰ ${t("menu")}</button></p></div></div>`}

