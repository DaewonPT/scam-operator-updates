<!DOCTYPE html>
<html lang="pt"><head><meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' file: data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' file: data: blob:; media-src 'self' file: data: blob:; font-src 'self' data:; connect-src https://scam-scores.daewonpt.workers.dev https://scam-stats.daewonpt.workers.dev; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SCAM Operator</title>
<style>
:root{--desk:#008080;--win:#c0c0c0;--fg:#111;--tb:#000080;--hi:#fff;--lo:#808080;--in:#fff;--warn:#ffe14d;--bad:#b00020;--ok:#0a6b2d;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--desk:#0b3b3b;--win:#3a3a3f;--fg:#f0f0f0;--tb:#3b3bb5;--hi:#5a5a62;--lo:#16161a;--in:#1b1b20;--bad:#ff6b81;--ok:#4cd987}}
*{box-sizing:border-box}
html,body{margin:0;background:var(--desk);color:var(--fg);font:14px/1.35 Tahoma,Verdana,sans-serif}
body{padding:8px 10px;max-width:620px;margin:0 auto}
body::after{content:"";display:block;position:fixed;top:0;left:0;bottom:0;right:0;background:linear-gradient(rgba(18,16,16,0) 50%,rgba(0,0,0,0.06) 50%);background-size:100% 4px;z-index:999;pointer-events:none}
.w{background:var(--win);border:2px solid;border-color:var(--hi) var(--lo) var(--lo) var(--hi);box-shadow:3px 3px 0 #0006;margin-bottom:8px}
.tb{background:var(--tb);color:#fff;padding:3px 8px;font-weight:700;display:flex;justify-content:space-between;align-items:center;user-select:none}
.b{padding:8px 10px}
button,select{touch-action:manipulation;-webkit-tap-highlight-color:transparent;font:inherit;color:var(--fg);background:var(--win);border:2px solid;border-color:var(--hi) var(--lo) var(--lo) var(--hi);padding:6px 10px;cursor:pointer;min-height:36px}
button:active:not(:disabled){border-color:var(--lo) var(--hi) var(--hi) var(--lo)}
button:disabled{color:var(--lo);cursor:not-allowed}
.big{width:100%;font-size:17px;font-weight:700;min-height:56px;padding:8px 10px;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.in{background:var(--in);border:2px solid;border-color:var(--lo) var(--hi) var(--hi) var(--lo);padding:6px 8px;width:100%;color:var(--fg);font:inherit}
.row{display:flex;gap:6px;align-items:center}.row>*{flex:1}
.bar{height:16px;background:var(--in);border:2px solid;border-color:var(--lo) var(--hi) var(--hi) var(--lo)}.bar i{display:block;height:100%;transition:width .2s}
.tabs{display:flex;gap:4px;margin-bottom:6px}.tabs button{flex:1;padding:5px 2px;min-height:32px;font-size:clamp(10px,3.1vw,14px)}.tabs .on{border-color:var(--lo) var(--hi) var(--hi) var(--lo);font-weight:700;background:var(--warn);color:#111}
.it{display:flex;gap:8px;align-items:center;padding:5px 0;border-bottom:1px solid var(--lo)}.it div{flex:1}.it small{display:block;opacity:.75}
.money{font-size:24px;font-weight:700}.small{font-size:12px;opacity:.85}.bad{color:var(--bad);font-weight:700}
.tip{background:var(--warn);color:#111;border:2px solid #111;padding:6px 8px;margin-top:6px;font-size:12px}
#toast{position:fixed;left:10px;right:10px;top:calc(10px + env(safe-area-inset-top,0px));max-width:600px;margin:0 auto;display:none;z-index:90;box-shadow:4px 4px 0 #0008}
#sc{position:relative;line-height:0;background:#3a3358;border-bottom:2px solid var(--lo);max-height:120px;overflow:hidden;display:flex;justify-content:center}
#sc svg{width:100%;max-width:320px;height:auto;max-height:120px;image-rendering:pixelated}
.fly{position:absolute;font-size:20px;animation:fl .8s forwards;pointer-events:none}
@keyframes fl{to{transform:translateY(-60px);opacity:0}}
@keyframes blinkheat{0%{opacity:1}50%{opacity:0.3}100%{opacity:1}}
.piscar{animation:blinkheat 0.5s infinite}
#logo-wrap{cursor:pointer;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent;display:block;width:100%;max-width:300px;margin:6px auto 10px;background:#008080 radial-gradient(ellipse at 50% 38%,#0a9797 0%,#007878 60%,#005d5d 100%);border:2px solid;border-color:var(--lo) var(--hi) var(--hi) var(--lo);padding:8px 8px 6px}
#logo-wrap img{display:block;width:100%;height:auto;pointer-events:none;-webkit-user-drag:none}
#home button{width:100%;margin-bottom:6px;font-size:16px}
#chat{position:fixed;inset:0;background:#000a;display:none;z-index:40;padding:10px;overflow:auto}
#msgs{height:42vh;overflow:auto;margin-bottom:6px}
#chat.tac #msgs{height:36vh}
#copts button{display:block;width:100%;margin-bottom:5px;text-align:left}
#aq{white-space:pre-line}
.m{padding:5px 8px;margin:4px 0;border:2px solid var(--lo);background:var(--in);white-space:pre-line}.m.u{background:var(--warn);color:#111;margin-left:24px}.m.v{margin-right:24px}.m.boss{background:#2a2540;color:#fff;border-color:#f1c40f}
.lang-btn{font-size:24px;padding:4px 8px;margin:3px}
.m.sp-boss{background:#2a2540;color:#fff;border-color:#f1c40f}
.m.sp-zeh{background:#cfe8ff;color:#111;border-color:#4a90d9}
.m.sp-insp{background:#16325c;color:#fff;border-color:#8fb3ff}
.m.sp-mart{background:#d9f2e0;color:#111;border-color:#2e8b57}
.m.sp-cop{background:#1d4d2b;color:#fff;border-color:#6fcf8f}
.m.sp-nar{background:transparent;font-style:italic;border-style:dashed}
.m.sp-exp{background:#2b1d4d;color:#fff;border-color:#b57bff;margin-right:24px}
.m.sp-tip{background:var(--warn);color:#111;border-color:#111;font-size:12px;margin-right:24px}
.gd{color:var(--ok);font-weight:700}
.tabs.t5{gap:2px}.tabs.t5 button{font-size:clamp(9px,2.6vw,13px);padding:5px 1px}.tabs.t5 button:last-child{flex:0 0 34px}
.m .who{display:block;font-size:11px;font-weight:700;opacity:.8;margin-bottom:2px;font-style:normal}
#story-skip{flex:0 0 auto}
#pg .tb{position:sticky;top:0;z-index:3;padding:6px 8px;font-size:15px}
.x{cursor:pointer;padding:2px 10px;margin:-2px -6px -2px 0}
.rk{width:100%;border-collapse:collapse;font-size:12px;margin:4px 0}.rk th,.rk td{padding:3px 4px;border-bottom:1px solid var(--lo);text-align:left;vertical-align:top}.rk th{background:var(--tb);color:#fff;font-size:11px}
.rk td:nth-child(2){overflow-wrap:anywhere}.rk td:first-child,.rk th:first-child{width:22px;text-align:right}.rk td:nth-child(n+3),.rk th:nth-child(n+3){text-align:right;white-space:nowrap}.rk tr.me td{background:var(--warn);color:#111}
.rks{display:flex;gap:4px;margin:4px 0}.rks button{flex:1;min-height:28px;padding:2px 4px;font-size:12px}.rks .on{border-color:var(--lo) var(--hi) var(--hi) var(--lo);font-weight:700;background:var(--warn);color:#111}
html[lang^="zh"] body,html[lang^="zh"] button,html[lang^="zh"] input,html[lang^="zh"] select{font-family:Tahoma,Verdana,"Microsoft YaHei","PingFang SC","Hiragino Sans GB","Noto Sans CJK SC","Noto Sans SC",sans-serif}
button,.tb{overflow-wrap:anywhere}
.ib{flex:0 0 auto!important;width:24px;min-width:24px;height:24px;min-height:24px;padding:0;margin:0 0 0 6px;border-radius:50%;background:var(--warn);color:#111;border:2px solid #111;font:italic 700 14px/1 Georgia,"Times New Roman",serif;text-align:center;vertical-align:middle}
.ib:active:not(:disabled){background:#fff;border-color:#111}
#home button.ib{width:30px;min-width:30px;height:30px;min-height:30px;margin:0 0 6px 6px;font-size:16px}
#inf-b{white-space:pre-line;margin:0 0 10px;line-height:1.4;max-height:58vh;overflow:auto}
.dl7{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin:6px 0}
.dc{border:2px solid;border-color:var(--hi) var(--lo) var(--lo) var(--hi);background:var(--win);text-align:center;padding:4px 0 2px;font-size:19px;line-height:1.15}
.dc small{display:block;font-size:10px;opacity:.85}
.dc.d{background:var(--in);opacity:.65}
.dc.t{background:var(--warn);color:#111;border-color:#111}
.sg{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:8px 0}
.sc{min-height:64px;font-size:30px;padding:2px}
.sc.o{background:var(--in);border-color:var(--lo) var(--hi) var(--hi) var(--lo)}

/* v4.4.1 — cabeçalho que nunca parte a linha, botão de clicar bloqueado */
.tb .app{flex:0 0 auto;white-space:nowrap;margin-right:6px}
#stn{display:flex;flex:0 1 auto;min-width:0;white-space:nowrap}
#stn>span{flex:0 0 auto}
#stn>.nm{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}
#home-tag{flex:0 1 auto;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* o tamanho encolhe (até 11px) conforme o comprimento do nome (--n, ver nmVar) para que 13 letras caibam em ecrãs de 360px; a 14px quando há espaço */
.tb .app,#stn,#home-tag{font-size:clamp(11px,calc((100vw - 40px) / (20.5 + .62 * var(--n,13))),14px);line-height:19px}
.big.lk{background:repeating-linear-gradient(135deg,var(--win) 0 8px,rgba(0,0,0,.18) 8px 16px);border-color:var(--lo) var(--hi) var(--hi) var(--lo);cursor:not-allowed}
.big.lk .t{opacity:.6}
.big.lk small{color:var(--bad);font-weight:700}

/* v4.5 — texto não selecionável (menos nos campos de escrita) e cartões da dificuldade */
*{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
input,textarea{-webkit-user-select:text;user-select:text}
img{-webkit-user-drag:none}
.nd-b{text-align:left;padding:8px 10px;min-height:56px}
.nd-b b{display:block;font-size:15px}
.nd-b small{display:block;margin-top:3px;font-size:12px;line-height:1.3;font-weight:400;white-space:normal;opacity:.9}

/* v5.0 */
.tabs.t5 button,.tabs.t6 button,.tabs.t7 button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;padding:3px 0;min-height:42px;line-height:1.05;font-size:clamp(8px,2.5vw,11px)}
.tabs.t4 button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;padding:3px 0;min-height:42px;line-height:1.05;font-size:clamp(9px,2.8vw,12px)}
.tabs button i{font-style:normal;font-size:18px;line-height:1}
.tabs button span{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tabs.t5,.tabs.t6,.tabs.t7,.tabs.t4{gap:2px}
.chb{cursor:pointer;font-size:11px;font-weight:400;max-width:55%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chp{border:2px solid var(--lo);padding:4px 6px;margin:6px 0;background:var(--in)}.chp>b{display:block}.chp>small{display:block;opacity:.8;margin-bottom:2px}
.strip{display:flex;flex-wrap:wrap;gap:2px;margin:2px 0 6px}.strip span{font-size:17px;padding:1px 3px;border:2px solid var(--lo);background:var(--in);opacity:.55}
.strip span.own{opacity:1;background:var(--win)}.strip span.cur{opacity:1;background:var(--warn);border-color:#111}.strip span.lk{filter:grayscale(1);opacity:.3}
.pa5{margin:6px 0 2px;border:2px solid var(--lo);padding:4px 6px;background:var(--in)}
.pag{display:grid;grid-template-columns:repeat(2,1fr);gap:4px}
.pab{display:flex;flex-direction:column;align-items:flex-start;text-align:left;padding:3px 6px;min-height:50px;position:relative}
.pab i{font-style:normal;font-size:18px;position:absolute;right:6px;top:3px}.pab b{font-size:12px;padding-right:22px}.pab small{font-size:10px;opacity:.85}
.pab u{text-decoration:none;position:absolute;right:6px;bottom:2px;font-size:11px;font-weight:700;color:var(--bad)}
#st5{font-size:11px;font-weight:700;min-height:0}
.tabs.t5 button:last-child,.tabs.t6 button:last-child,.tabs.t7 button:last-child{flex:1 1 0!important}

/* casino */
.hand{display:flex;gap:4px;flex-wrap:wrap;margin:2px 0 6px}
.pc{display:inline-block;min-width:36px;padding:5px 5px;text-align:center;font:700 16px/1.1 monospace;background:#fff;color:#111;border:2px solid #111;border-radius:3px;box-shadow:2px 2px 0 #0004}
.pc.rd{color:#c00}
.pc.bk{background:repeating-linear-gradient(45deg,#1a3a8a,#1a3a8a 4px,#2a52c0 4px,#2a52c0 8px);color:#fff}
.rlw{text-align:center;margin:4px 0 8px}
.rlb{display:inline-block;min-width:58px;padding:10px 12px;font:700 28px/1 monospace;border:3px solid #111;border-radius:50%;color:#fff;box-shadow:inset 0 0 0 3px #fff3}
.rlb.rd{background:#c0152a}.rlb.bl{background:#111}.rlb.gr{background:#0a8a3a}
.slw{display:flex;justify-content:center;gap:6px;margin:6px 0;padding:8px;background:#111;border:3px solid var(--warn);border-radius:6px}
.slr{display:inline-block;width:60px;text-align:center;font-size:38px;line-height:60px;background:#fff;border:2px solid #111;border-radius:4px}

/* v5.0 — conforto: efeitos, acessibilidade, ecrã na vertical */
#fx{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:120}
.fxp{position:absolute;top:-34px;will-change:transform;animation:fxd 1.7s ease-in forwards}
.fxp.up{top:auto;bottom:34%;animation-name:fxu;animation-duration:1.5s;animation-timing-function:ease-out}
@keyframes fxd{0%{transform:translateY(0) rotate(0);opacity:1}85%{opacity:1}100%{transform:translateY(108vh) rotate(360deg);opacity:0}}
@keyframes fxu{0%{transform:translateY(0) scale(.6);opacity:1}100%{transform:translateY(-38vh) scale(1.25) rotate(40deg);opacity:0}}
.fxf{position:absolute;inset:0;animation:fxfl .8s ease-out forwards}
@keyframes fxfl{0%{opacity:1}100%{opacity:0}}
#game.shk{animation:shk .5s}
@keyframes shk{10%,50%,90%{transform:translateX(-5px)}30%,70%{transform:translateX(5px)}}
.big:active:not(:disabled){transform:scale(.985)}
#rot{position:fixed;inset:0;z-index:300;background:var(--desk);color:#fff;display:none;align-items:center;justify-content:center;text-align:center;font-size:18px;padding:20px}
body.fs1{zoom:1.12}body.fs2{zoom:1.25}
.chp .bar{margin-top:3px}
.noanim *,.noanim *::before,.noanim *::after{animation:none!important;transition:none!important}
.noanim .fly{display:none}
:root.hico{--desk:#fff;--win:#fff;--fg:#000;--tb:#000;--hi:#000;--lo:#000;--in:#fff;--warn:#ffd400;--bad:#a00000;--ok:#005a00}
.hico body::after{display:none}
.hico .tabs .on,.hico .rks .on{outline:3px solid #000}
.hico .small,.hico small{opacity:1!important}
@media (prefers-color-scheme:dark){
:root.hico:not([data-theme="light"]){--desk:#000;--win:#000;--fg:#fff;--tb:#fff;--hi:#fff;--lo:#fff;--in:#000;--warn:#ffd400;--bad:#ff8a8a;--ok:#6dff6d}
:root.hico:not([data-theme="light"]) .tb,:root.hico:not([data-theme="light"]) .rk th{color:#000}
:root.hico:not([data-theme="light"]) .hico .tabs .on{outline-color:#fff}
}

/* v5.0 — diversão: fúria, pop-ups, ecrã azul */
.fy{margin-top:4px}.fy .bar{height:8px}.fy i{background:#d99a00}.fy small{display:block;font-weight:700;margin-top:1px}
.fy.on i{background:linear-gradient(90deg,#ff6a00,#ffd000);animation:fyp .45s infinite alternate}
@keyframes fyp{from{filter:brightness(1)}to{filter:brightness(1.45)}}
.pop5{position:fixed;z-index:84;width:min(300px,88vw);margin:0;box-shadow:5px 5px 0 #000a;animation:popin .18s ease-out}
.pop5 .b{text-align:center}.pop5 .big{font-size:34px;line-height:1.1;min-height:0;padding:0;border:0;background:none;box-shadow:none}
.pop5 .row button{flex:1}.pop5 .pgo{font-weight:700;background:var(--warn);color:#111}
@keyframes popin{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}
#bsod{position:fixed;inset:0;z-index:93;background:#0000aa;color:#fff;font-family:"Courier New",monospace;padding:6vh 6vw;display:none;font-size:15px;line-height:1.5;overflow:hidden}
#bsod.up{background:var(--desk);padding:0 10px}
#bsod .bsb{max-width:520px;margin:0 auto}#bsod .bsf{font-size:72px;line-height:1;margin-bottom:12px}#bsod p{margin:0 0 12px}
#bse{animation:bsbl 1s steps(2) infinite}@keyframes bsbl{50%{opacity:.25}}

/* v5.0 — diversão parte 2: coleção, rodapé de notícias, cenas */
.cgr{display:grid;grid-template-columns:repeat(6,1fr);gap:4px;margin:6px 0 2px}
.cgr button{font-size:24px;line-height:1;min-height:42px;padding:2px}
.cgr button.no{opacity:.55;filter:grayscale(1)}
.cgr button.sel{border-color:var(--lo) var(--hi) var(--hi) var(--lo);background:var(--warn);color:#111}
#tk5{position:fixed;left:0;right:0;bottom:0;z-index:30;max-width:620px;margin:0 auto;height:calc(24px + env(safe-area-inset-bottom,0px));padding-bottom:env(safe-area-inset-bottom,0px);background:#05050f;border-top:2px solid var(--hi);color:#ffd000;font:700 12px/22px "Courier New",monospace;overflow:hidden;white-space:nowrap}
#tk5::before{content:"📰";position:absolute;left:0;top:0;width:28px;height:22px;text-align:center;background:#05050f;z-index:1;line-height:22px}
#tkt{display:block;margin-left:30px;overflow:hidden;text-overflow:ellipsis}
#tkt.go{display:inline-block;margin-left:0;padding-left:100%;overflow:visible;text-overflow:clip;will-change:transform}
@keyframes tkm{from{transform:translateX(0)}to{transform:translateX(-100%)}}
body.tkp{padding-bottom:calc(34px + env(safe-area-inset-bottom,0px))}
.hs{position:relative;height:120px;border:2px solid;border-color:var(--lo) var(--hi) var(--hi) var(--lo);background:linear-gradient(#8fd0ff 0,#e1f4ff 62%,#74b86b 62%,#5aa05a 100%);overflow:hidden;line-height:1}
.hs.nt{background:linear-gradient(#0b1030 0,#2a3470 62%,#2f5a35 62%,#244a2c 100%)}
.hs i{position:absolute;font-style:normal}
.hsk{right:8px;top:4px;font-size:20px}
.hsh{left:5%;bottom:34%;font-size:62px}
.hsp{left:46%;bottom:6%;font-size:26px}.hsf{left:58%;bottom:6%;font-size:30px}
.hsg{position:absolute;left:0;right:0;bottom:2%;height:24px}
.hsg i{bottom:0;left:2%;font-size:18px;white-space:nowrap}
.hsw{animation:hsw 16s linear infinite alternate}
@keyframes hsw{from{left:2%}to{left:68%}}
.hss{display:flex;flex-wrap:wrap;align-items:center;gap:3px;margin-top:5px;padding:3px 6px;background:#8a5a2b;border:2px solid #4b2e12;min-height:28px;font-size:17px;line-height:1.15;color:#fff}
.hss i{font-style:normal}.hss small{opacity:.8;font-size:12px}
#npc5{position:absolute;left:0;right:0;bottom:0;height:22px;pointer-events:none;overflow:hidden;line-height:1}
.npc{position:absolute;bottom:1px;left:0;font-size:15px;line-height:1;font-style:normal;animation:npcw 18s linear infinite alternate,npcb .7s steps(2,end) infinite}
@keyframes npcw{from{left:2%}to{left:90%}}
@keyframes npcb{50%{transform:translateY(-2px)}}
html.noanim .npc,html.noanim .hsw{animation:none}
/* v5.0 — diversão parte 3: mini-jogos (cabos, guião, lista de contactos) */
.cbw{position:relative;display:flex;justify-content:space-between;padding:10px 12%;margin:8px 0;background:#1b2430;border:2px solid;border-color:var(--lo) var(--hi) var(--hi) var(--lo)}
.cbc{display:flex;flex-direction:column;gap:10px;position:relative;z-index:2}
.cbl{position:absolute;left:0;top:0;width:100%;height:100%;z-index:1;pointer-events:none}
.cbp{width:60px;height:46px;font-size:24px;line-height:1;padding:0;color:#fff;text-shadow:0 0 3px #000,0 0 2px #000;border:3px solid #fff;border-radius:10px}
.cbp.sel{outline:3px solid #fff;box-shadow:0 0 0 3px #000,0 0 14px 5px #fff;transform:scale(1.1)}
.cbp.ok{opacity:.6}
.cbw.shk,#gsc.shk{animation:cbs .32s}
@keyframes cbs{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.gsp{margin:4px 0 8px;padding:6px 8px 6px 28px;background:#fffbe6;color:#222;border:2px solid;border-color:var(--lo) var(--hi) var(--hi) var(--lo);min-height:34px;font-size:13px;line-height:1.35}
.gsp li{margin:2px 0}.gsp li.gse{list-style:none;opacity:.5}
button.gsc{display:block;width:100%;margin:4px 0;padding:9px 8px;text-align:left;white-space:normal;line-height:1.3;font-size:13px}
