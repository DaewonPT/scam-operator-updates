/* v5.3 — janelas de ecrã inteiro (arranque, abertura, capítulos, viagem, protetor de ecrã, saída, créditos, aviso, política) */
.ov53{position:fixed;inset:0;display:none;overflow:auto;-webkit-tap-highlight-color:transparent}
/* arranque */
#boot5{z-index:400;background:#000;color:#c7c7c7;font:14px/1.5 "Courier New",Consolas,monospace;cursor:pointer;opacity:1;transition:opacity .3s}
#boot5.out{opacity:0}
#boot5 .bt-bios{padding:calc(18px + env(safe-area-inset-top,0px)) 16px;max-width:620px;margin:0 auto}
#boot5 .bt-bios p{margin:2px 0}
#boot5 .bt-cur{font-style:normal;animation:blk53 .8s steps(1) infinite}
@keyframes blk53{50%{opacity:0}}
#boot5.std:not([style*="none"]){display:flex!important;align-items:center;justify-content:center}
.bt-std{text-align:center}
.bt-dw{font:900 clamp(34px,11vw,64px)/1 "Courier New",monospace;letter-spacing:2px;color:#ffe14d;text-shadow:3px 3px 0 #b00020,6px 6px 0 #000080}
.bt-dw span{display:inline-block;opacity:0;animation:dw53 .35s steps(3) forwards}
@keyframes dw53{0%{opacity:0;transform:translateY(-14px)}100%{opacity:1;transform:none}}
.bt-pr{margin-top:12px;color:#9fffa8;letter-spacing:4px;text-transform:lowercase;opacity:0;animation:fi53 .4s .6s forwards}
@keyframes fi53{to{opacity:1}}
#boot5.spl:not([style*="none"]){display:flex!important;align-items:center;justify-content:center;background:#008080 radial-gradient(ellipse at 50% 40%,#0a9797 0%,#007878 55%,#004a4a 100%);color:#fff}
.bt-spl{width:min(420px,88vw);text-align:center;font-family:Tahoma,Verdana,sans-serif}
.bt-logo img{display:block;width:100%;height:auto;image-rendering:pixelated}
.bt-logo b{font-size:32px}
.bt-os{margin:6px 0 12px;font:700 14px/1 "Courier New",monospace;letter-spacing:6px;color:#e8ffff;text-shadow:2px 2px 0 #000080}
.bt-bar{height:16px;background:#fff;border:2px solid;border-color:#808080 #fff #fff #808080;padding:2px}
.bt-bar i{display:block;height:100%;width:0;background:repeating-linear-gradient(90deg,#000080 0 10px,transparent 10px 13px);transition:width .12s linear}
.bt-st{margin-top:6px;font-size:12px;opacity:.9}
.bt-sk{margin-top:14px;font-size:11px;opacity:.65}
.tip53{margin:14px auto 0;max-width:420px;text-align:left;background:#ffe14d;color:#111;border:2px solid #111;padding:6px 8px;font:12px/1.35 Tahoma,Verdana,sans-serif;box-shadow:3px 3px 0 #0006}
/* título */
.ttl53{background:#0b1430}
.ttl53 .ttb{position:absolute;inset:-6% -12%;background-size:cover;background-position:0% 60%;animation:pan53 38s ease-in-out infinite alternate}
@keyframes pan53{to{background-position:100% 40%}}
.ttl53.nt .ttb{filter:brightness(.55) saturate(.8) hue-rotate(195deg)}
.ttl53 .tts{position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(#fff 1px,transparent 1.5px),radial-gradient(#cdf 1px,transparent 1.5px);background-size:47px 31px,83px 57px;background-position:0 0,19px 11px;animation:tw53 3s ease-in-out infinite alternate}
@keyframes tw53{from{opacity:.35}to{opacity:.9}}
.ttl53 .ttop{position:absolute;right:4%;bottom:0;font-size:clamp(46px,14vw,78px)}
html.noanim .ttl53 .ttb,html.noanim .ttl53 .tts{animation:none}
.trm53{max-width:300px;margin:-2px auto 8px;background:#000;color:#33ff66;font:12px/1.4 "Courier New",monospace;padding:3px 8px;border:2px solid;border-color:var(--lo) var(--hi) var(--hi) var(--lo);white-space:nowrap;overflow:hidden}
.trm53 i{font-style:normal;animation:blk53 .8s steps(1) infinite}
#home .bq53{margin-top:2px;opacity:.85}
/* cena de abertura */
#cine5{z-index:110;background:#000;color:#fff}
#cine5 .cn-p{position:relative;max-width:620px;margin:calc(46px + env(safe-area-inset-top,0px)) auto 0;aspect-ratio:16/9;overflow:hidden;border:2px solid #fff4;background:#000}
#cine5 .cn-p.fi{animation:fi53 .6s ease-out}
#cine5 .cn-i{position:absolute;inset:0;background-size:cover;background-position:center;animation:kb53 7s ease-out forwards}
#cine5 .cn-i.night{filter:brightness(.5) saturate(.7) hue-rotate(200deg)}
@keyframes kb53{from{transform:scale(1.08)}to{transform:scale(1)}}
#cine5 .cn-s{position:absolute;left:50%;bottom:2%;transform:translateX(-50%);font-size:clamp(60px,20vw,118px)}
#cine5 .cn-w{position:absolute;right:4%;top:6%;font-size:clamp(46px,15vw,90px);animation:fi53 .5s 1s both}
#cine5 .cn-x{position:absolute;left:58%;top:12%;font-style:normal;font-size:42px;animation:fi53 .4s .8s both}
#cine5 .cn-e{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:80px}
#cine5 .cn-mail{position:absolute;inset:8% 10%;background:var(--win);color:var(--fg);border:2px solid;border-color:var(--hi) var(--lo) var(--lo) var(--hi);display:flex;flex-direction:column}
#cine5 .cn-mail .b{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;font-size:13px}
#cine5 .cn-mail .b .sp{font-size:52px}
#cine5 .cn-t{max-width:600px;margin:12px auto;padding:0 14px;min-height:4.5em;font:16px/1.5 "Courier New",monospace;color:#e8f0ff}
html.noanim #cine5 .cn-i{animation:none}
/* capítulo */
#chap5{z-index:105;background:#000d;display:none;align-items:center;justify-content:center;cursor:pointer}
#chap5[style*="block"]{display:flex!important}
.ch-c{text-align:center;color:#fff;padding:20px;animation:chz53 .6s cubic-bezier(.2,1.4,.4,1)}
@keyframes chz53{from{transform:scale(.6);opacity:0}to{transform:none;opacity:1}}
.ch-c .ch-i{font-size:96px}
.ch-c .ch-e{font-size:72px}
.ch-n{margin-top:8px;font:700 14px/1 "Courier New",monospace;letter-spacing:6px;color:#ffe14d}
.ch-t{margin-top:8px;font:900 clamp(24px,7vw,36px)/1.1 Tahoma,Verdana,sans-serif;text-shadow:3px 3px 0 #000080}
.ch-s{margin:10px auto 0;max-width:360px;font-size:13px;opacity:.85}
/* viagem */
#map5{z-index:105;cursor:pointer}
.mp-w{position:relative;max-width:560px;margin:0 auto;padding:calc(60px + env(safe-area-inset-top,0px)) 14px 20px;text-align:center}
.mp-d{display:flex;align-items:center;gap:6px;margin:16px 0}
.mp-d>span{flex:0 0 36%;aspect-ratio:4/3;background-size:cover;background-position:center;border:3px solid #fff;box-shadow:3px 3px 0 #000a;position:relative;display:flex;align-items:center;justify-content:center;transform:rotate(-3deg)}
.mp-d>span.mp-b{transform:rotate(3deg);animation:fi53 .5s 2.2s both}
.mp-d>span i{font-style:normal;font-size:42px}
.mp-d>span b{position:absolute;left:0;right:0;bottom:0;background:#000a;font-size:12px;padding:2px}
.mp-r{flex:1;position:relative;height:60px;border-bottom:3px dashed #fff8}
.mp-pl{position:absolute;left:0;bottom:6px;font-style:normal;font-size:30px;animation:pl53 2.4s ease-in-out forwards}
@keyframes pl53{0%{left:-10%;bottom:0}50%{bottom:34px}100%{left:85%;bottom:4px}}
html.noanim .mp-pl{animation:none;left:80%}
/* protetor de ecrã */
#ss5{z-index:350;background:#000;cursor:none}
#ss5 canvas{display:block;width:100%;height:100%}
/* saída */
#bye5{z-index:380;background:#000;display:none;align-items:center;justify-content:center;text-align:center;cursor:pointer}
#bye5[style*="block"]{display:flex!important}
.by-t{color:#ff8c00;font:700 clamp(18px,5.5vw,30px)/1.4 Tahoma,Verdana,sans-serif;max-width:560px;padding:20px}
.by-s{position:fixed;left:0;right:0;bottom:24px;color:#777;font-size:12px}
/* créditos */
#cred5{z-index:120;overflow:hidden}
.cr-w{position:absolute;inset:0;overflow:hidden;mask-image:linear-gradient(transparent,#000 12%,#000 88%,transparent);-webkit-mask-image:linear-gradient(transparent,#000 12%,#000 88%,transparent)}
.cr-r{position:absolute;left:0;right:0;top:100%;text-align:center;padding:0 16px;animation:cr53 32s linear forwards}
.cr-r h3{margin:18px 0 4px;color:#ffe14d;font:700 13px/1.3 "Courier New",monospace;letter-spacing:3px;text-transform:uppercase}
.cr-r p{margin:2px 0;font-size:15px;color:#e8f0ff}
@keyframes cr53{to{transform:translateY(calc(-100% - 100vh))}}
/* aviso inicial, avisos e política */
#dsc5{z-index:115}
#dsc5 .ovl{padding-top:calc(40px + env(safe-area-inset-top,0px));max-width:520px}
#dsc5 .ovl p{color:#e8f0ff;font:15px/1.5 Tahoma,Verdana,sans-serif}
#dsc5 .ds-b{background:#ffe14d;color:#111!important;border:2px solid #111;padding:8px 10px;font-weight:700}
.warn53{background:var(--bad);color:#fff;font-weight:700;padding:8px 10px;margin:0 0 8px;border:2px solid #000;font-size:13px}
.nmw53{margin-top:6px;padding:4px 6px;background:var(--warn);color:#111;border:1px solid #111}
#pv5{z-index:100;background:var(--desk);padding:10px;padding-top:calc(10px + env(safe-area-inset-top,0px))}
#pv5>.w{max-width:620px;margin:0 auto}
.pvb h1{font-size:18px;margin:0 0 6px}.pvb h2{font-size:15px;margin:14px 0 4px}.pvb p,.pvb li{font-size:13px;line-height:1.45}.pvb a{color:inherit;font-weight:700}
.ver53{margin:6px 0 0;padding:6px 8px;background:var(--in);border:1px solid var(--lo);font-size:12px}
.pre53{white-space:pre-wrap;word-break:break-all;font:10px monospace;max-height:160px;overflow:auto;background:var(--in);padding:4px}
#pin5{z-index:97;background:#000a;padding:10px}
#pin5>.w{max-width:360px;margin:20vh auto 0}
#pin5 .in{font-size:22px;letter-spacing:8px;text-align:center}
/* tutorial: a camada não apanha toques, só a caixa de texto */
#tut5{z-index:60;pointer-events:none;overflow:visible}
.tu-r{position:fixed;border:3px solid #ffe14d;border-radius:6px;box-shadow:0 0 0 4px #0008,0 0 16px #ffe14d;animation:tur53 1s ease-in-out infinite alternate;pointer-events:none;transition:all .2s}
@keyframes tur53{to{box-shadow:0 0 0 4px #0008,0 0 28px 6px #ffe14d}}
.tu-b{position:fixed;left:10px;right:10px;max-width:420px;margin:0 auto;pointer-events:auto;background:#ffffe1;color:#111;border:2px solid #111;box-shadow:4px 4px 0 #0008;padding:8px 10px;font-size:14px}
.tu-b p{margin:0 0 6px}
.tu-b .row button{min-height:30px}
html.noanim .tu-r{animation:none}
/* daltonismo: bom = azul, mau = laranja (vermelho-verde) · bom = verde-azulado, mau = rosa (azul-amarelo); riscas na barra da polícia */
:root.cb1{--ok:#005ab5!important;--bad:#c45a00!important}
:root.cb2{--ok:#007a6e!important;--bad:#c2185b!important}
@media (prefers-color-scheme:dark){:root.cb1:not([data-theme="light"]){--ok:#6cb4ff!important;--bad:#ffa04d!important}:root.cb2:not([data-theme="light"]){--ok:#4fd1c5!important;--bad:#ff7eb3!important}}
:root.cb1[data-theme="noite"],:root.cb1[data-theme="hacker"],:root.cb1[data-theme="abobora"],:root.cb1[data-theme="bf"],:root.cb1[data-theme="natal"]{--ok:#6cb4ff!important;--bad:#ffa04d!important}
:root.cb2[data-theme="noite"],:root.cb2[data-theme="hacker"],:root.cb2[data-theme="abobora"],:root.cb2[data-theme="bf"],:root.cb2[data-theme="natal"]{--ok:#4fd1c5!important;--bad:#ff7eb3!important}
:root.cb1 #hb[data-lv="3"],:root.cb2 #hb[data-lv="3"]{background-image:repeating-linear-gradient(45deg,#0007 0 6px,transparent 6px 12px)!important}
:root.cb1 #hb[data-lv="2"],:root.cb2 #hb[data-lv="2"]{background-image:repeating-linear-gradient(90deg,#0004 0 3px,transparent 3px 9px)!important}
