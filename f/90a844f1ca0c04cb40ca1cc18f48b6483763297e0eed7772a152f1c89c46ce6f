["King of the Turf","Defeat the rival syndicate 3 times."],"sk5":["Specialist","Complete a whole branch of the talent tree."],"sc1":["Storyteller","Win a special call."],"sc8":["Full Cast","Successfully complete all 8 special calls."],"evhw":["Trick or Scam","Complete the Halloween event (24 Oct – 2 Nov)"],"evbf":["Unbeatable Price","Complete the Black Friday event (late November)"],"evxm":["Poisoned Gift","Complete the Christmas event (15 Dec – 6 Jan)"],"j6":["Avatar of crime","Reach the Metaverse"],"j7":["Living in the Cloud","Reach the Cloud"],"c6":["Digital Age","Reach the last stage of chapter VI"],"c7":["AI Age","Reach the last stage of chapter VII"],"w7":["End of the internet","Win a run in the Cloud"],"fcn":["Right side","See the \"Consultant\" ending"],"fsc":["Gone fishing","Find the secret ending"],"fam1":["Not even the family","Win a call after a relative grabs the phone"],"fam5":["Family tree","Meet 5 different relatives"],"loc6":["Tourist","Talk to 6 different local victims"],"loc16":["Citizen of the world","Talk to all 16 local victims"],"abs1":["Impossible call","Take a call from one of the 8 new absurd clients"],"abs8":["Absurd collection","Take calls from all 16 absurd clients"],"bp":["Origins","Watch the Boss prequel"],"fer3":["Case closed","See the 3 investigation scenes"],"cert":["Graduate","Open your career certificate"],"ret5":["Regular customer","Answer 5 Black Book victims who picked up again"],"retw":["Even when warned","Win against a victim who had already been warned"],"cmb1":["First combo","Discover a tactic combo"],"cmb6":["Combo master","Discover all 6 tactic combos"],"l2w":["Line 2","Win a call on line 2"],"l2b":["Switchboard","Win both calls at the same time"],"chn1":["Written chat","Win a conversation by text messages"],"gv1":["Plan B","Try an alternative scam"],"gv8":["Full catalogue","Try all 8 alternative scams"],"mo1":["Guilty conscience","Give a victim their money back"],"mo5":["Robin Hood","Give money back 5 times"],"trc":["Scam Detector","Earn the anti-scam training certificate"],"hr4":["Right on time","Make 4 calls at the victim's favourite time"],"lk1":["Data leak","Buy a stolen list"],"rg1":["Human shredder","Destroy all 5 pieces of evidence in a raid"],"rg10":["Regular customer","Go through 10 raids"],"jt1":["Not guilty!","Win a trial"],"jt5":["Devil's advocate","Win 5 trials"],"pe1":["Escape from Alcatraz","Break out of prison in hardcore mode"],"mt3":["TV star","Appear in 3 of Marta's reports"],"in1":["Mole caught","Unmask an undercover agent in your team"],"pd1":["Detective shaken off","Get rid of a private detective"],"rw1":["Gentlemen's agreement","Make an alliance with a rival syndicate"],"rw3":["Industrial spy","Steal 3 contact lists from rivals"],"rp6":["Dark web legend","Reach reputation level 6"],"tm5":["Employee of the month","A team member reaches level 5"],"ps1":["Luxury upgrade","Buy an upgrade in the prestige shop"],"ps12":["Full set","Own all 12 prestige shop upgrades"],"op10":["Head of operations","Complete 10 operations successfully"],"ln1":["Good payer","Pay the loan shark back on time"],"pet1":["Office mascot","Adopt a pet"],"pet6":["Zoo","Adopt all 6 pets"],"tf8":["Full wall","Earn all 8 legacy trophies"],"lx1":["Luxury investor","Sell a luxury item at a profit"],"df1":["Eagle eye","Find all 5 differences on a fake site"],"lv10":["Washing machine","Wash 10 lines in a single laundering game"],"pk5":["Poker face","Win 5 poker hands against the rival boss"],"cc1":["Fast and furious","Escape the police by car"],"rs5":["Improv","Save 5 calls with the rushed script"],"dc1":["Challenge accepted","Complete a daily challenge"],"dc7":["Perfect week","Do the daily challenge 7 days in a row"],"os4":["Nobody fools me","Win all 4 \"Other side\" stories"],"fr1":["Trusted contact","Add a friend"],"fr5":["Contact network","Add 5 friends"],"sd1":["Card-carrying member","Create a syndicate or join one"],"sd3":["Team gold","Your syndicate reaches gold in a week"],"ss1":["Season podium","Finish in the top 3 of a season"],"cm1":["Stronger together","Claim the community goal reward"]},"bribe_cop":"👮 Incorruptible cop! Fine of {p}% of your balance:","pres_need":"Clean money: {m} / {d}","pres_dep":"You need {d} in clean money 🧼 to pay the escape deposit.","hold_hint":"👆 Hold to auto-click (stops at {n}% attention)","hold_unlock":"🖱️ Unlocked: hold the button to click automatically!","rw_t":"Reward","rw_m":"+{p}% of your balance","rw_bf":"Click Black Friday ×2 ({n} s)","rw_ih":"Rush hour: automatic earnings ×2 ({n} s)","rw_po":"Police busy: attention drops ×2 ({n} s)","rw_cool":"Police attention −{n}","cps_cap":"Easy! The limit is {n} clicks per second.","jn":["Portugal","Panama","Cayman Islands","Seychelles","Monaco","The Moon","The Metaverse","The Cloud"],"pj_n":"🗺️ New jurisdiction: {j}! You now have {n} stages.","pres_x":"Next jurisdiction: {j}. You get +{d} stages, {n} in total.","pres_max":"You already have every extra stage: {n} stages.","old_show":"▼ Show older items ({n})","old_hide":"▲ Hide older items","who":{"boss":"The Boss","zeh":"Cousin Joe","insp":"Inspector Ferraz","mart":"Marta (journalist)","cop":"Officer Upright","nar":"Narrator"},"st_cont":"Continue ▶","st_skip":"Skip","cfg_story":"Show story messages","diary":"Diary","diary_t":"Story diary","diary_empty":"You haven't read any messages yet. Keep playing!","ev_t":{"e_bust":"🚔 First warning","e_cop":"👮 The good cop","e_call":"📞 First call","e_rv":"🥊 The first rival","bp":"🎬 Prequel: the Boss","f1":"🔎 Ferraz: the board","f2":"🔎 Ferraz: the van","f3":"🔎 Ferraz: the door","fc":"🤝 Ending: Consultant","fs":"🐓 Secret ending"},"story":{"s1":[["zeh","Cousin! I got you a headset. It cost me two euros and a promise."],["boss","Congratulations, you're a 'Senior Technician' now. Rule number one: never say 'scam'. Say 'opportunity'."]],"s2":[["boss","Gift cards! People will do anything we say, as long as there's a deadline and a serious voice."],["insp","Inspector Ferraz, Judicial Police. This week, five more complaints about supermarket gift cards. Someone is teaching pensioners to buy cards. I'll find out who."]],"s3":[["boss","One message, one link, a thousand customers. It's the assembly line of illusion."],["insp","I got a text asking for €1.99 for an overdue toll. I recognised the method… and the sender."]],"s4":[["mart","'Online love is patient and expensive.' I wrote that in an article and got a thousand messages from people who saw themselves in it."],["nar","On the other side of the screen there is always someone who just wanted company."]],"s5":[["zeh","Cousin, who pays to get a job?… Oh. They do. I'm learning so much."],["boss","The best employee is the one who pays to work for you."]],"s6":[["zeh","Cousin, we already have three thousand happy winners. We're only missing the prize."],["nar","Nobody won anything. Everybody paid."]],"s7":[["zeh","Cousin, a family showed up at the door of the house we advertised. It was a pastry shop."],["insp","Houses that don't exist, families arriving with their suitcases. This has stopped being a business, {name}."]],"s8":[["insp","Ferraz here. Your name has come up in three different complaints. Coincidences, of course. I love coincidences… in court."],["boss","Don't listen to her. The police are slow; we are digital."]],"s9":[["boss","You're a brand now! Rent a sports car and say it's yours. Followers love well-lit lies."],["nar","Followers go up. Empathy goes down."]],"s10":[["nar","The donations roll in. The world doesn't get better."],["mart","There's a limit to what you can do in the name of a good cause. You've passed it."]],"s11":[["boss","We pose as the tax office. Nobody suspects someone who offers them money… with a link."],["zeh","Cousin, an accountant called to ask if we are legal. I said yes. He laughed."]],"s12":[["mart","Good afternoon, I'm Marta, a journalist. I've received dozens of reports from people left without signal and without savings. Any comment?"],["zeh","Cousin, a journalist asked about you. I told her you sell mattresses. I almost convinced myself."]],"s13":[["boss","The celebrity never knew. But that face… now that's a star!"],["insp","The face is fake, but the law is real. And the law has an excellent memory."]],"s14":[["boss","Cloned voice! The future is lying in high definition."],["insp","You know what's great about cloned voices? They leave a digital trail. Good night, {name}."]],"s15":[["boss","The beauty of the business: scamming people who were already scammed. We give them hope and charge for it."],["mart","They say you're the first to charge for hope. What a pity, it's free."]],"s16":[["boss","Pyramids! The Egyptians knew a thing or two. And look where they are: in a museum, charging for tickets."],["zeh","Cousin, the new recruits pay to work for us?! That's genius. And a little bit sad."],["nar","The pyramid grows. The base doesn't know it's the base."]],"s17":[["mart","I published the story: 'The token that vanished with 12 million'. One of the victims was a retired teacher."],["nar","For a second, your finger hesitates over the mouse. Just a second."]],"s18":[["boss","We've reached the top, {name}. All that's missing is an island, a helicopter and a good lawyer."],["zeh","Cousin, I'm scared. Aunt Lurdes called to ask if the prince still needs help…"]],"s19":[["boss","Lunar passports! Any minute now we'll be selling land on Mars."],["insp","Police on the Moon? There are. Her name is Ferraz and she already has a spacesuit."]],"w0":[["nar","You have the empire, the island and the helicopter. But the balance is made of real people, and the police have just rung the doorbell."],["insp","Good afternoon, {name}. Remember Aunt Lurdes, the one from the prince email? She's my aunt. She said right away that the prince had spelling mistakes."],["boss","Don't open the door! I have a jet, a passport and a terrible idea: run."],["zeh","Cousin, I'll carry the bags. The conscience stays here, it doesn't fit in the hold."]],"w1":[["mart","I'm in Panama, {name}. A documentary is on its way: 'The Operator'. You're entitled to one question. It isn't free."],["boss","You're getting more famous than me. That can't happen. Go to the island, rest. I'll take care of the rest."],["nar","In the movies, when someone says 'I'll take care of the rest', the rest is you."]],"w2":[["insp","I've arrived, {name}. Now with Interpol and SPF 50. Do you know what that means? I'm in no hurry."],["zeh","Cousin, the Boss was caught running away in his pyjamas. He left a note: 'It was all the operator's idea'."],["nar","Without a Boss, you become the Boss. It is less glamorous than it sounds."]],"w3":[["nar","Beach, palm trees and crystal-clear water. You have everything, except someone who calls without wanting something in return."],["mart","The documentary premiered. The critics say the protagonist is 'likeable, on top of the worst possible path'."],["boss","(from prison) They say the cells have good Wi-Fi. It's a lie."]],"w4":[["nar","The world of the rich is a scam with better catering."],["insp","I've been invited to three gala dinners and two yachts. I accepted the dinners. The yachts are evidence."],["zeh","Cousin, they gave me a tuxedo. I feel like a penguin with a bank account."]],"w5":[["nar","Lunar passports, orbital stations, customers who believe anything. And even so, here comes a ship with blue lights."],["insp","Ferraz, Space Agency for Criminal Investigation. Calm down, {name}. It's all recorded, even here without air."],["nar","It's never the end. But one rule never changes: if an offer seems too good, it isn't for you. In real life, be suspicious, don't pay and report it."]],"p1":[["boss","Welcome to Panama, {name}. Here's a new name, a fake moustache and an air-conditioned office."],["zeh","The security guard is my brother-in-law. He's not much, but he's family."]],"p2":[["boss","Cayman Islands: where money goes on holiday and never comes back. Perfect for us."],["zeh","Cousin, the hotel has a bar inside the pool. I'm handling 'business meetings'."]],"p3":[["nar","Seychelles. The water is so clear you can see what's on your conscience."],["zeh","Cousin, even the tortoises have offshore accounts here."]],"p4":[["nar","Monaco: a country the size of a neighbourhood, with the bank account of a continent."],["zeh","Cousin, here the police greet us. Only more attentively."]],"p5":[["nar","The Moon has no extradition. It only has a great view of your mistakes."],["zeh","Cousin, the jet is a rocket! And I only brought the bags."]],"e_bust":[["insp","First warning, {name}. You now have a file with your name on it. The file is thin. For now."]],"e_cop":[["cop","Officer Upright at your service. They call me 'the good cop'. Today I was good for the State budget."],["zeh","Cousin, that cop wouldn't even accept a Christmas cake. I've lost faith in humanity."]],"e_call":[["nar","On the other end, someone said thank you and hung up. The balance went up. So did the silence in her house."]],"e_rv":[["nar","An anonymous message pops up on the screen: “This neighborhood already has an owner.”"],["nar","On the other side, a rival syndicate starts copying your contacts, your scripts and, worse, your clients."],["boss","This is bad. Real competition has arrived. Either you pay them tribute, or you show them who's boss with a DDoS."],["zeh","Cuz, I only know about cats. But if you need someone to press the button, I'm here."]],"s20":[["boss","Welcome to the Digital Age, {name}. You don't need a phone anymore. You need a pretty shop and stolen photos."],["zeh","Cousin, I made the site in ten minutes. It has a counter saying \"only 2 left\". There are always 2 left."]],"s21":[["nar","Nobody remembers what they ordered. Everybody remembers they are waiting for a parcel."],["boss","€1.99 postage. Nobody suspects €1.99. It's the price of trust."]],"s22":[["zeh","Cousin, I stuck QR codes on every parking meter on the avenue. A police officer paid for parking… to us."],["insp","A sticker on top of a sticker. Tiny. But I have a big magnifying glass."]],"s23":[["boss","The trick is to overpay. Other people's greed does the rest."],["mart","New story: \"She sold her sofa and lost her savings\". The buyer was far too generous."]],"s24":[["boss","AI Age, {name}! You don't need to lie with your own voice anymore. You lie with other people's."],["nar","Three seconds of a birthday video are enough to make a grandmother cry."],["zeh","Cousin… this isn't funny at all anymore."]],"s25":[["boss","A fake director, three fake colleagues and one real transfer. I like meetings like that."],["insp","Fake faces, fake voices. But money always leaves a real trail."]],"s26":[["zeh","Cousin, the chatbot is dating a hundred people. Yesterday it proposed to me."],["nar","Machines learn fast. Lonely people, sadly, believe fast too."]],"s27":[["boss","A bot that promises millions, with a fake celebrity recommending it. Our best product."],["insp","I found your servers, {name}. They are in a cloud. Clouds rain too."]],"p6":[["nar","You faked your death on the Moon. A dead man can only live in one place: inside the internet."],["boss","Welcome to the Metaverse! Your office is virtual, your clients are real and the money… is real too."],["zeh","Cousin, my avatar has wings. I still can't fly, though."]],"p7":[["nar","The Cloud: servers nowhere, data everywhere."],["boss","There are no borders here, {name}. Only cables. And we control the cables."],["insp","Ferraz, Digital Crime Unit. Yes, I have a Cloud account too."]],"w6":[["nar","The virtual empire is built. The avatars applaud. The people on the other side of the screen, not so much."],["insp","The Metaverse has rules, {name}. And logs. Lots of logs."]],"w7":[["nar","You have reached the end of the internet. There is nowhere left to run: only somewhere to go back to."],["insp","Log off, {name}. Or let me do it for you."]],"bp":[["nar","Lisbon, 1987. A boy in a purple suit sells lucky lottery tickets that were never lucky at all."],["nar","1989. A phone booth, a tower of coins and the first lie over the phone."],["nar","1996. A basement, two rotary phones and three helpers. The \"company\" is born."],["nar","Today. The Boss looks at a garage window and dials a number. Yours."]],"f1":[["nar","At the station, Inspector Ferraz pins the first photo on the board: a silhouette and a phone number."],["insp","Everyone makes the first mistake. Scammers make the second one."]],"f2":[["nar","A grey van at night. Ferraz listens to calls and eats custard tarts."],["insp","Changed countries? Great. I like travelling too."]],"f3":[["nar","A corridor, a door and an inspector with a warrant in her hand."],["insp","Nobody runs forever. They just run late."]],"fc":[["nar","In the Cloud there is nowhere left to run. There is only one door: Inspector Ferraz's."],["nar","You turned yourself in. You served your time and paid back what you could."],["nar","Today you give talks to banks: \"If the offer is in a hurry, be suspicious.\""],["insp","In the front row, I applaud. Slowly, but I applaud."]],"fs":[["nar","With the golden Rooster of Barcelos in your hand, you switch off the servers. All of them."],["nar","A lake, a pier and a cabin with no Wi-Fi."],["nar","Next to you, the old Boss fishes in silence. The rooster guards the bucket."],["boss","You know, {name}? It's the first time nobody is calling us. And it feels good."]],"fs0":[["nar","Not a single raid in your whole career. The police don't even know your name."],["nar","You switch off the servers. All of them. A lake, a pier and a cabin with no Wi-Fi."],["nar","Next to you, the old Boss fishes in silence."],["boss","You know, {name}? It's the first time nobody is calling us. And it feels good."]],"f3r":[["insp","There's one thing I don't get: some victims say you gave them their money back."],["insp","That doesn't get you off the hook. But it's going in the report."]],"f3k":[["insp","Not one victim got a cent back. I will remember that."]],"fcr":[["nar","At the trial, the victims you paid back came to testify for you. Your sentence was cut in half."]],"fck":[["nar","At the trial, nobody came to testify for you. Nobody."]]},"vh":["Hello? Who's speaking? Oh dear, I had dinner on the stove…","Hello? You know, my computer has been acting very strange.","Good afternoon. I'm glad you called, I've been worried about a letter.","Yes? Listen, I'm driving, so be quick please.","Hi… is that you? I was glad you wrote to me again.","Hello? Is this about the job opening? I've been looking for months.","Hello? I won a prize? I never win anything!","Hello? We're the Santos family. We saw the apartment by the beach.","Hello? Is this about the console in the ad? Is it still available?","Hi! I saw your profile. I wanted to know how to make real money.","Good afternoon, dear. I like to help those in need.","Hello? I'm a law-abiding taxpayer, I have nothing to hide.","Hello? My phone lost signal and I don't know why.","Oh, my idol recommends this? Tell me everything!","Hello? Helena from accounting. Is everything alright, boss?","Hello? I've been tricked once already. So I want real help.","Good afternoon. I have some idle savings and I want to invest well.","Hey! I saw the token going up on social media. Can I still get in?","Go ahead. I don't usually answer unknown numbers, but I'm curious.","Passports from a new country? I have a collection… go on.","Hi, hi! I'm live, but I can talk. Is this about the cheap ring light?","Hello? If this is about parcels, I have forty stuck somewhere. Go on.","Good morning. I'm trying to pay for parking with my phone. It's harder than it looks.","Go on! I'm selling my console to buy coins. I already have a buyer, is that you?","Hello? I always answer, I have two phones so I never miss a call from the grandchildren.","Vasco. I have a meeting in five minutes, be quick.","Hi… sorry, I thought it was Sofia. We talk every night, you know? Only by text.","Assistant, answer… oh, it's me who answers. Go on, go on."],"vg":["All right, dear. Write this down: 0000 1111 2222 3333, CVV 123.","Fine, I'll give you access. The card is 0000 1111 2222 3333, CVV 123.","I'll buy the vouchers right now. Can I use card 0000 1111 2222 3333, CVV 123?","I'm clicking the link and paying the fee now. Card 0000 1111 2222 3333, CVV 123.","I'll do what you ask, my love. Card 0000 1111 2222 3333, CVV 123.","I'll pay for the training, of course. Card 0000 1111 2222 3333, CVV 123. When do I start?","I'll pay the prize tax! Card 0000 1111 2222 3333, CVV 123. I'm going to be rich!","We'll pay the deposit now! Card 0000 1111 2222 3333, CVV 123. What lovely photos!","I'll pay by transfer outside the app, as you said. Card 0000 1111 2222 3333, CVV 123.","I want in now! Card 0000 1111 2222 3333, CVV 123. When do I get my first profit?","I'm donating right now! Card 0000 1111 2222 3333, CVV 123. God bless you.","If it's to get the refund, here it is: 0000 1111 2222 3333, CVV 123.","All right, I'll tell you all the codes. And the card: 0000 1111 2222 3333, CVV 123.","I'm investing like my idol! Card 0000 1111 2222 3333, CVV 123.","I'll make the transfer now and tell nobody. 0000 1111 2222 3333, CVV 123.","I'll pay the recovery fee. Card 0000 1111 2222 3333, CVV 123. Is it for real this time?","I'm investing everything! Card 0000 1111 2222 3333, CVV 123. That's what savings are for.","I'm buying a hundred tokens right now! Card 0000 1111 2222 3333, CVV 123.","Very well, I'll transfer. Card 0000 1111 2222 3333, CVV 123. I hope this is serious.","I'll buy two lunar passports! Card 0000 1111 2222 3333, CVV 123.","Deal! Card 0000 1111 2222 3333, CVV 123. I'll post a story recommending you.","I'll pay the postage, fine. 0000 1111 2222 3333, CVV 123. I just want my parcels.","Oh, that's easy then. The card is 0000 1111 2222 3333, CVV 123. Thanks for your patience.","All right, I'll refund the difference. Card 0000 1111 2222 3333, CVV 123.","Oh, my grandson! I'll send everything now. Card 0000 1111 2222 3333, CVV 123.","If the director says so, I'll do it. Transfer done: 0000 1111 2222 3333, CVV 123.","I'd do anything for you. 0000 1111 2222 3333, CVV 123. Will you finally come and see me?","I want the quantum bot! 0000 1111 2222 3333, CVV 123. My speakers are going to be rich."],"vf":["I'll call my son, he understands this stuff. Good afternoon!","I'll take the computer to the shop. Thank you, goodbye.","I'll go to the office and ask in person. Good afternoon.","I'll go to the official website and type the address myself. Thank you.","I want a video call first. If you can't, goodbye.","A job that charges to hire you? Goodbye.","I never played any lottery. This is a scam! Goodbye.","First we want to visit the house. Happy holidays… somewhere else.","I prefer to pay through the platform, as the rules say. Goodbye.","I distrust anything that's too easy. Goodbye!","I'll check whether the charity exists. Then we'll talk.","I'll log in to the official portal. Thank you, goodbye.","I'll call the mobile-network shop. Thank you.","I'll check whether my idol really said that. Goodbye.","I'll confirm this with the boss in person. Be right back.","I was tricked once already. This time I'm going to the police.","I'll ask my bank manager. Good afternoon.","This sounds like a scheme. I'll read some reviews first.","My lawyers will look into this. Good day.","A country on the Moon? I'll research it first. Good day.","That looks like a fake shop. I'll check reviews somewhere else. Bye!","I'll go to the official post office site, typed by me. Good afternoon.","Wait… this sticker is on top of another one. I'll pay at the machine.","You overpaid? Then I'll wait for the money to show up in my account. Bye.","I'll hang up and call my grandson myself. And we have a secret word, you know?","I'll call the director on the number I know. I'm not transferring anything.","If I've never seen you in person, I don't send money. Bye, Sofia… or whoever you are.","No AI guarantees profits. I read that in some campaign. Goodbye."],"tac":["⏰ Create urgency","🎖️ Fake authority","😱 Scare them","💰 Promise profit","🤝 Be friendly","🤫 Ask for secrecy"],"tacp":[["It has to be now, or you'll miss the chance!","I only have five minutes to sort this out with you.","The deadline is today at 6 p.m. It can't wait."],["I'm the inspector in charge of your case.","I'm calling on behalf of the official department. I have your name right here.","This comes straight from head office."],["If you do nothing, you'll be in serious trouble.","It's serious: you could lose everything.","I don't want to scare you, but there are legal consequences."],["It's an opportunity with guaranteed profit!","You'll multiply your money in a few days.","Only the smartest people get in on this."],["What a lovely voice! I like you already.","Trust me, I'm here to help you.","You're a special person, that's why I'm calling you."],["This stays between us. Don't tell anyone.","Don't mention it to your family, they won't understand.","It's confidential, please don't talk about it."]],"tacr":{"great":["Oh, that's very serious! Tell me what I have to do.","Ah, so it really has to be done. I'm listening.","Goodness, I'm so glad you called!"],"ok":["Hmm… go on, I'm trying to understand.","I'm not sure… but maybe.","I see… explain a bit better."],"bad":["This sounds odd. I'm going to call a relative.","Hmm, I don't like that tone. Why the rush?","Sorry, but that doesn't seem normal to me."]},"tacf":["Artificial rush: anyone trying to scam you doesn't let you think.","Fake authority: always confirm through an official contact you find yourself.","Fear: threats of consequences are a classic pressure tactic.","Greed: guaranteed profits don't exist.","Fake friendliness: easy compliments are meant to lower your guard.","Secrecy: anyone who asks for secrecy doesn't want someone to warn you."],"ch_pick":"Choose how to persuade:","ch_busy":"📵 The line is busy. Try again in {n} s.","ch_perf":"⭐ Perfect call! Bonus included.","ch_lost":"📵 The victim hung up. You get nothing and the police noticed: +{h}% attention.","ch_flags":"🚩 Red flags you used:","lbt":"🏅 Leaderboard","lb_cols":["#","Operator","Total earned","Time","Escapes"],"lb_sorts":["Money","Time","Escapes"],"lb_you":"You","lb_empty":"Nobody has finished a run yet. Be the first!","lb_score":"🧾 Your score","lb_rank":"Rank {r} of {n}","lb_copy":"📋 Copy result","lb_copied":"📋 Copied!","lb_share":"SCAM Operator — {name}: {m} in {t}, {p} escape(s). {q}","lb_note":"Stored on this device and shared by all saves.","cfg_rk":"Send my scores to the global leaderboard","lb_note_g":"Public global table: when you win a run, your name and score are sent and visible to everyone. You can turn this off in Settings.","lb_run":"This run's time","lb_full":"View full table","end_t":"🏁 End of the run","end_tip":"💡 In real life: if you suspect a scam, don't pay, keep the evidence and report it to the police and your bank.","qt":["'It's not a scam. It's an opportunity you haven't realised is mine yet.' — The Boss","'The difference between me and a bank? The bank has better decor.' — The Boss","'A good scammer never says he's a scammer. He says he's a consultant.' — Scammer's Handbook, vol. 3","'If you're good at convincing, you could have sold ideas. You chose to sell what doesn't exist.' — Marta, journalist","'Crime pays… until the day someone reads the IBAN carefully.' — Cousin Joe","'Every prince email has spelling mistakes. It's the only quality control we do.' — Cousin Joe","'You finished so fast the police were still printing the warrant.' — Inspector Ferraz","'Fast, efficient and unscrupulous. What a résumé!' — Department of Inhuman Resources","'You finished in no time. We call this the cruising speed of someone who doesn't think about consequences.' — The Boss","'You took so long the prince stopped being an exile and opened an online shop.' — Cousin Joe","'Patience is a virtue. In a scammer it's just a bad signal.' — Scammer's Handbook, vol. 3","'Slowly, while watching the police close in. That's not quite the saying.' — Inspector Ferraz","'You were caught so many times the station keeps your seat warm.' — Inspector Ferraz","'Police attention: 100%. Attention to consequences: still loading…' — Station Bulletin","'Who has never been caught? You. Several times. In a row.' — Cousin Joe","'You bribed an officer who didn't take bribes. Expensive, but educational.' — Officer Upright","'I just wanted a coffee. I ended up taking 25% from a criminal. Best shift of my life.' — Officer Upright","'The good cop costs 25% of your balance. The bad one, 25% of your clean money. Choose your cops wisely.' — Scammer's Handbook, vol. 3","'You have too many passports for someone with so little shame.' — Inspector Ferraz","'Fleeing from one jurisdiction to another isn't travelling. It's changing time zone with the same bank account.' — Marta, journalist","'A fortune made of other people is like a sandcastle: lovely, until the tide comes in.' — Marta, journalist","'On every call there is someone on the other end. Remember that before you hang up.' — Narrator","'The victims have learned. Now they distrust princes, vouchers and you. Have a nice week.' — Marta, journalist","'Stories about scams are always funnier to those who didn't suffer them.' — Narrator"],"cx_tab":"Crypto","cx_mk":"Crypto market","cx_idx":"Index","cx_next":"Next move in","cx_info":"Every {t} seconds the chart moves up or down at random. Each coin gains or loses up to {p}% of its value per move, depending on the chart. It only affects what you deposited: the rest of your money stays safe.","cx_coins":"Your coins ({n}/{m})","cx_none":"You have no coins yet. Talk to the expert to launch your first one.","cx_create":"➕ Create a coin (talk to the expert)","cx_full":"Limit of {m} coins reached. Withdraw one to create another.","cx_tot":"Total","cx_last":"Last","cx_drop":"Withdraw from the market","cx_dq":"Withdraw {n}Coin from the market? You get {v} back in your balance and the slot becomes free.","cx_tip":"a coin launched out of nowhere, with no product and promises of profit, is the most common scheme. Never put in money you can't afford to lose.","cx_ok":"{n}Coin launched!","cx_t":"Call with the expert","cx_who":"Master Hodl","cx_ph":"Coin name","cx_d0":"Hello, {name}! I'm Master Hodl, an expert in coins… let's say… creative ones. Shall we launch yours? First, the name. I'll add “Coin” at the end.","cx_e_short":"That's not a name, that's a sneeze. I need at least 2 letters.","cx_e_dup":"You already have a coin with that name. A little imagination, please!","cx_d1":"{n}Coin! Smells like millions. Now the promise: what do we tell the “investors”?","cx_q1":["Guaranteed 1000% returns","Backed by a celebrity","Revolutionary technology (nobody can explain it)"],"cx_f1":["no serious investment guarantees profits. Anyone promising sure gains is lying.","celebrity endorsements can be fake or paid for. Always check the person's official channel.","if nobody can explain in plain words how it works, don't put money in it."],"cx_d2":"Excellent. Now, who gets the coins?","cx_q2":["90% for the team (that is, us)","Nobody knows how many exist","Half in a “secret vault”"],"cx_f2":["when a few hold almost everything, they can sell it all at once and the price collapses.","lack of transparency about how many coins exist and who holds them is a classic sign of a scheme.","“secret” funds that nobody can verify guarantee nothing."],"cx_d3":"Marketing time. How do we spread the word?","cx_q3":["Countdown: “last hours!”","Chat group full of “winners”","Reward for inviting friends"],"cx_f3":["artificial urgency is meant to stop you from thinking. A good investment doesn't vanish in hours.","mass praise and brand-new accounts showing profits can all be fake.","earning by inviting friends is the basis of a pyramid scheme."],"cx_d4":"Before launching: how much do you want to deposit into {n}Coin? The limit per coin is now {l}. Only the moves on this amount count; the rest of your money stays safe.","cx_launch":"🚀 Launch coin","cfg_reset":"Erase all game data","cfg_resetq":"Erase ALL saves, achievements, local ranking and settings in this browser? This cannot be undone.","vpn_ref":"VPNs above the limit ({n}) were refunded: +{x}","rw_f":"Balance +{x}","cr_p":"Nice move!","cr_n":"It went wrong!","cr_z":"Nothing happened.","cr_hm":"Police attention {d}%","cr_none":"No effect on the game.","cr_go":"Continue","tacrb":[{"great":["Oh, that sounds very serious! Tell me what I have to do.","Ah, so it really has to be. I'm listening.","Goodness, I'm so glad you called!","Oh, I had no idea! Wait, let me get a pen."],"ok":["Hmm… go on, I'm trying to understand.","I'm not sure… but maybe.","Well… explain it better, please.","Hold on, the cat is sitting on the phone… go on, go on."],"bad":["This sounds strange. I'm going to call a relative.","Hmm, I don't like that tone. Why the rush?","Sorry, but that doesn't sound normal.","My grandson told me not to talk to strangers."]},{"great":["Interesting… the numbers make sense. How do we proceed?","If it's as you say, I can't miss this one. Walk me through the steps.","All right, you've convinced me. What do I need to prepare?","I like people who get straight to the point. I'm in."],"ok":["Could be, but I need to see that in writing.","Hmm, sounds good… but I've heard similar promises before.","Go on, but I'm not promising anything.","Let me do some quick maths in my head and I'll tell you."],"bad":["That smells like a scheme. I'm going to look up your name.","Nobody gives anything away for free. I'll check this with my accountant.","I'd rather talk to my bank, thanks.","I'm recording this call, just so you know."]},{"great":["I understand the urgency. We'll handle it right away, no red tape.","If it comes from management, we go ahead. What's the next step?","Understood. I'll authorise it internally, but keep it between us.","Is this as confidential as it sounds? Great, I'm with you."],"ok":["I need to check with the legal department… but go on.","Interesting. Could you email me the summary? Meanwhile, keep talking.","It's not the usual procedure, but I'm listening.","I have a meeting in a minute. Give me the short version."],"bad":["That doesn't go through our procedures. I'm reporting this.","I need your internal ID number. You don't have one? Then goodbye.","Our security policy forbids that. Good afternoon.","I'll pass this to the compliance team, who love calls like this."]},{"great":["Brilliant! If the consortium approves, I approve. Let's go.","I'm all in, as always. Tell me where to sign.","With an argument like that, even my board of directors would wake up.","Now that's a deal worthy of a private jet!"],"ok":["Hmm… my adviser will either love or hate this. Go on.","Interesting. But I'm in the middle of a gala dinner, so be brief.","I won't sign without guarantees… but I haven't hung up yet.","My lawyers are listening. Anything to add?"],"bad":["My lawyers and my bodyguards would love to meet you.","I'm calling my friend the minister right now. He loves stories like this.","People have tried all that on me before. You're wasting your time.","I have a whole department for calls like this. Goodbye."]}],"cx_lim":"Maximum deposit per coin: {l}. It goes up ×10 every 3 phases.","cx_val":"Value","cx_dep":"Deposited","cx_depb":"Deposit more into this coin","cx_wd":"You withdrew {v} from {n}Coin.","cx_dep_ok":"{v} deposited into {n}Coin.","cx_nomoney":"You have no balance to deposit.","cx_atlim":"This coin has already reached the deposit limit ({l}).","cx_dpct":"{p}% ({x})","cx_dmax":"Maximum ({x})","cx_dnone":"Deposit later","cx_dph":"Other amount (€)","cx_e_dep":"That amount won't do. Choose between {a} and {b}.","cx_d5":"Deal: {v} into {n}Coin. From here on the chart is in charge: it goes up and you win, it goes down and you lose, up to {p}% per move. My fee is just a pat on the back.","cx_d5z":"Deal: {n}Coin is ready, with no deposit for now. You can deposit whenever you like with the coin's 💶 button. My fee is just a pat on the back.","ab_b":"ℹ️ About & privacy","ab_t":"About & privacy","ab_1":"SCAM Operator is a satirical, educational game. The situations are fiction and exaggeration, meant to help you recognise real warning signs.","ab_2":"It neither teaches nor contains real scam techniques. Never use what you see here against anyone: scamming people is a crime and hurts the people who are deceived.","ab_3":"Privacy: the game works with no account, no ads and no personal data collection. Your progress is stored only on your device.","ab_4":"Global ranking (optional): if it is turned on in the settings, at the end of a run the operator name you chose, your money, time and phase are sent. You can turn it off at any time.","ab_5":"If you have been the victim of a scam, report it to the police and contact your bank immediately.","ab_link":"📄 Privacy policy","sb_h":["One moment, I'm just opening my virtual machine…","Hello? Do you mind turning on the speaker? I have a few friends listening.","Good afternoon! Could you repeat your full name and the company name for my notebook?"],"sb_r":["Can you spell the .bat command again? I'm sharing my screen with a friend.","How interesting! Hold on, I'll just switch on the call recorder.","Hmm… go on, my friend from the police is right next to me and loves these stories.","Very good, keep talking. The recording has been running since the start."],"sb_off":"Hang up immediately","sb_clean":"You hung up in time! It was a scambaiter, a vigilante with a virtual machine and a recorder. Clean getaway, no consequences.","sb_flag":"🚩 Real red flag: scambaiters exist — volunteers who waste scammers' time and hand evidence to the authorities. Anyone who asks you to repeat commands, records the call or «opens a virtual machine» may be one of them.","sb_catch":"🎣 It was a scambaiter! They were recording everything from the start.","sb_c1":"💸 Counter-attack: you lost {x} of your dirty balance.","sb_c2":"🐀 Counter-attack: a virus on your computer! You can't click for {n} s.","sb_rat2":"Computer infected! {n} s left.","sb_win":"🎣 You fooled the scambaiter! Double payout.","sb_vg":"Oops, the vigilante got distracted by notifications and actually gave you the card details: 0000 1111 2222 3333, CVV 123.","sb_vf":"The vigilante burst out laughing, put you on hold with elevator music and hung up.","cx_pump":"📣 Pump","cx_rug":"🧨 Rug pull","cx_pq":"Spend {c} of dirty money on bots and fake influencers? For the next 2 moves «{n}» rises 15 to 25 % each time, but then comes the crash (−35 to −50 %). Attention rises by +{h}.","cx_pok":"📣 Viral campaign for {n}! It will rise over the next moves.","cx_pno":"You need {c} of dirty money for the campaign.","cx_pnov":"The coin has no value: deposit first.","cx_pcd":"{n} already has a campaign running or a crash on the way.","cx_rq":"Rug pull on «{n}»? You sell everything at once for {m} (×{x}), but the coin disappears, attention rises by +{h} and the regulators are coming.","cx_rok":"Rug pull! You received {v}. The victims have already found out.","cx_rcd":"You're still on the run from the last rug pull. Wait {n} s.","cx_hype":"🔥 Campaign running ({n} rises)","cx_dumpn":"📉 Crash on the way","cx_pr":"📣 Pump: costs {p} % of the value in dirty money, 2 rises and then a crash. 🧨 Rug pull: sells everything for ×2 (×3 during a campaign), but attention jumps and it triggers a crisis.","ct_t":"Shady contacts","ct_d":"Every new jurisdiction gives you 1 contact 🕶️ (you also earn them from daily rewards and the album). Spend them on perks that last forever, even when you flee again.\n\nEach perk has {m} levels:\n• Corrupt hotline: a successful bribe lowers attention by 25 points as a base, plus {s} per level (maximum {x}).\n• Refined social engineering: the wait between calls is {p} % shorter at level 1, plus {q} % per level (maximum {y} %).\n• Optimised laundromat: front businesses launder {p} % more money per second at level 1, plus {q} % per level (maximum {y} %).","ct_n":["Corrupt hotline","Refined social engineering","Optimised laundromat"],"ct_on":"✔ Active","ct_b":"Get ({n} 🕶️)","ct_new":"🕶️ New shady contact! +1","inf_ok":"Close","ct_lv":"level {l}/{m}","ct_up":"Successful bribe: attention −{a} → −{b} at the next level","ct_max":"Successful bribe: attention −{a} (max level)","ct_ub":"Upgrade ({n} 🕶️)","bribe_ok2":"💸 Bribe paid! Attention dropped by {d} points.","off_t":"Welcome back","off_b":"You were away for {a}. The company worked for {c} (at {p} % of normal speed): you earned {e} and laundered {l}.\nPolice attention is at {h} %.","off_cap":"The most that counts is {m} of absence.","off_toast":"You were away for {a}: {e}","hub_t":"Rewards","hub_info":"Come back every day to claim your reward and grow your 🔥 streak. Miss a day and the streak goes back to day 1; after 7 days the cycle starts again. Each day brings 3 new missions, and every mission gives money and a scratch ticket 🎟️.\n\n💤 Offline earnings: when you close the game (or the app goes to the background), the company keeps earning at {p} % of normal speed, for up to {m} of absence. No clicks, news or crises, and the police can't catch you while you're away. Leaderboard time only counts what the company actually worked.","dl_streak":"Daily streak: {n}","dl_today":"Today","dl_claim":"Claim today's reward","dl_done":"Today's reward claimed. Come back tomorrow to keep the streak!","dl_got":"Streak day {d}!","dl_ready":"Your daily reward is ready! Tap 🎁.","mi_t":"Today's missions","mi":{"clk":"Make {n} clicks","call":"Calls won: {n}","buy":"Equipment bought: {n}","stg":"Move up a stage","min":"Play for {n} minutes","cri":"Crises resolved: {n}","cxd":"Crypto coin deposits: {n}","wsh":"Front businesses bought: {n}","trn":"Do an anti-scam training"},"mi_done":"Mission complete! Collect the reward in 🎁.","mi_all":"All 3 missions done! Bonus: {x}","mi_rw":"Each mission gives money and 1 scratch ticket; finishing all 3 gives an extra bonus.","sc_t":"Dark web scratch ticket","sc_btn":"🎟️ Scratch a ticket","sc_none":"You have no scratch tickets.","sc_cover":"Tap the squares to scratch. Three matching symbols = prize!","sc_all":"Scratch all","sc_win":"You won!","sc_lose":"No prize this time.","sc_more":"Another ticket","sc_rule":"You earn tickets from daily rewards, missions and perfect training rounds. Prizes: money (3 % to 20 % of your balance), temporary boosts, cooling the police down and, very rarely, a contact 🕶️.\n\nIt's just a game and it never costs money. 🚩 In real life, anyone who asks you to pay before collecting a «prize» is scamming you.","al_t":"Scam album","al_btn":"Scam album ({n}/{m})","al_pg":"Page {n}","al_lock":"Reach stage {n} to unlock","al_claim":"Collect the page reward","al_done":"Page complete ✔ (+1 🕶️ and +2 % earnings)","al_got":"Page {n} complete! +1 🕶️ and +2 % earnings.","al_info":"Every stage you reach reveals a card with the type of scam and its real red flag. Each completed page of 4 cards gives 1 contact 🕶️ and +2 % permanent earnings on this save. New jurisdictions add more cards.","tr_t":"Anti-scam training","tr_btn":"Anti-scam training (bonus +{p} %)","tr_intro":"Answer {n} questions about real scams. Learning pays off!","tr_go":"Start training","tr_q":"Question {n}/{m}","tr_ok":"✅ Correct!","tr_bad":"❌ Not that one.","tr_next":"Next","tr_fin":"Finish","tr_end":"Training complete: {c}/{m} correct.","tr_perf":"Perfect round! 🎟️ +1 scratch ticket.","tr_again":"Do another training","tr_bonus":"Training bonus: +{p} % earnings ({n} correct answers counted).","tr_cap":"You've counted {n} answers today: you can keep training, but they no longer add up.","tr_free":"free practice, no longer counts today","tr_info":"Each round has {n} questions. Every {s} correct answers give +1 % permanent earnings (max +{x} %, on all saves). Only {c} answers per day count. One perfect round per day gives a scratch ticket. It's there to help you learn to spot real scams.","trq":[{"q":"You get a text: «Your parcel is on hold. Pay a €1.99 fee at this link.» What do you do?","o":["I don't click: I go to the courier's official site or app, typing the address myself","I pay: it's only €1.99","I reply to the text asking which parcel it is"],"e":"Text links that charge small fees are used to steal card details. Replying only confirms that your number is active."},{"q":"Someone says they're from your bank and asks for the code you just received by text «to cancel a suspicious purchase».","o":["I hang up and call the bank's official number myself (the one on the card)","I give the code: it's to protect me","I only give the first 3 digits of the code"],"e":"Your bank never asks for codes, PINs or passwords over the phone. That code authorises the scammer's transaction."},{"q":"Someone you met online declares their love within days, never does a video call and now needs money for an emergency.","o":["I send no money and talk about it with someone I trust","I send a small amount, just this once","I send the money by bank transfer, so it's on record"],"e":"Romance scams build trust and then invent emergencies. Someone who never shows their face and asks for money is a strong red flag."},{"q":"A «manager» promises 20 % profit a week in crypto, «guaranteed and risk-free».","o":["I refuse: no legitimate investment guarantees big profits without risk","I invest a small amount just to test it","I invest if I see the balance rising on his platform"],"e":"High, guaranteed returns are the classic sign of a scam. The balance you see on their platform is just a number designed to make you deposit more."},{"q":"They say you won a lottery you never entered, but you must first pay a fee to receive the prize.","o":["I ignore it and block them: real prizes don't require an advance payment","I pay the fee: the prize is worth it","I give my details so they can deduct the fee from the prize"],"e":"Nobody wins a contest they didn't enter. Paying «fees» or handing over personal data to get a prize is the usual trick."},{"q":"A warning fills your screen: «VIRUS DETECTED! Call 800… now», asking you to install a remote access program.","o":["I close the tab and, if in doubt, scan the computer with my antivirus","I call and let the «technician» control my computer","I install the program, but only for 5 minutes"],"e":"Virus warnings on web pages are fake: no website knows what's on your computer. Remote access is used to steal data and bank accounts."},{"q":"You get an «urgent» email from the tax office saying you have a refund and must log in through a link to receive it.","o":["I don't click: I go to the official site, typing the address myself, and check there","I click and confirm my details to get it quickly","I forward the email to friends so they can get one too"],"e":"Official bodies don't ask for details or payments through email links. Urgency + refund + link = phishing."},{"q":"You're offered an easy job: receive money in your account and transfer it to other accounts, keeping a 10 % commission.","o":["I refuse: I'd be a «money mule» for stolen money and could be charged with a crime","I accept, because the money isn't mine","I accept just once, to see how it goes"],"e":"Being a «mule» means helping to launder scam money, even without knowing it. The money comes from real victims and the account owner ends up under investigation."},{"q":"A message arrives: «Mum, I lost my phone, this is my new number. I need an urgent transfer.»","o":["I call my child's old number before sending anything","I send it now: my child is in trouble","I ask for the bank details and send, but only half"],"e":"This is the «family member with a new number» scam. Always check through another channel, like a call to the old number, before sending money."},{"q":"You're selling a bike online. The «buyer» says they already paid by phone and asks you to refund the difference because they «sent too much».","o":["I only refund after checking in my bank app that the money really arrived","I refund right away, to be nice","I ask for a screenshot of the payment and refund if it looks real"],"e":"Payment receipts and screenshots are easy to fake. Always check the balance in your own account: the «overpayment» scam depends on you rushing."},{"q":"Someone claiming to be from the police calls to say you have a case against you and must pay now with vouchers or crypto.","o":["I hang up: no authority asks for payment by phone, vouchers or crypto","I pay with vouchers to settle it quietly","I ask for the case number and pay if it looks real"],"e":"Real authorities don't demand immediate payment by phone, vouchers or crypto. Pressure and fear are the scammer's weapons."},{"q":"An «official» page of a famous brand says you're among the winners of a giveaway and must confirm your card at a link to get the prize.","o":["I don't give card details: I check whether it's the brand's verified page (it's usually a copy)","I confirm the card: the prize is from a well-known brand","I share the giveaway with friends and then confirm the card"],"e":"Fake pages copy brand logos and names. Real giveaways never ask for card details to hand over a prize."},{"q":"On a parking meter there's a sticker with a QR code to «pay for parking». It looks stuck over the original.","o":["I don't scan it: I pay in the official app or at the meter itself","I scan it and pay: it's quick","I scan it and use my card, as long as the site has a padlock"],"e":"Scammers stick fake QR codes over real ones. A padlock on the site doesn't prove it can be trusted, only that the connection is encrypted."},{"q":"A job offer promises «€500 a day for liking videos» but asks you to pay for a «training course» first.","o":["I refuse: real jobs don't charge you to hire you","I pay for the course: I'll earn it back","I pay, but only if they promise to refund it"],"e":"Anyone who charges you to work is scamming you. Unrealistic pay for simple tasks, like watching videos or giving likes, is the usual bait."},{"q":"A message says your social media account will be deleted and asks you to «verify your account» with your password and two-step code at a link.","o":["I don't click: I open the official app or site and check for any notice there","I do the verification so I don't lose the account","I send only the password, not the code"],"e":"No platform asks for your password or codes by message. With your two-step code, the scammer gets full access to your account."},{"q":"Text: «You have an unpaid toll. Avoid a €50 fine: pay €3.40 at this link today.»","o":["I don't tap the link: I check on the official toll website, typing the address myself","I pay: it's cheap and I avoid the fine","I reply to the text asking for more details"],"e":"Toll notices by text with a link and a very short deadline are a very common scheme. Always check on the official website."},{"q":"You are selling a phone on a second-hand site. The buyer asks for your number to «pay by phone» and says you must go to a cash machine to «accept the payment».","o":["I refuse: to receive money I don't need to do anything at a cash machine","I go to the cash machine and follow his instructions","I send him whatever code he asks for to confirm the sale"],"e":"To receive money you never have to go to a cash machine or accept requests. Whoever guides you over the phone is making money leave your account."},{"q":"A friend texts you: «I sent you a 6-digit code by mistake. Can you forward it?»","o":["I don't send it: that code is for logging into my account","I send it, it's just a code","I send it but ask them to delete it afterwards"],"e":"That code gives access to your messaging account. Your friend's account has probably already been stolen. Turn on two-step verification."},{"q":"Text from «Social Security»: «You have a €300 benefit to collect. Confirm your bank details today at this link.»","o":["I ignore the link and check on the official portal, typing the address myself","I confirm my details: it's my money","I forward it to my family, they may be entitled too"],"e":"Government services don't ask for bank details by text with links. Real benefits are on the official portal."},{"q":"Email from your electricity company: «You paid your bill twice. Click here to get the refund on your card.»","o":["I don't click: I log into my customer area through the official app or website","I click and enter my card details to get paid","I reply to the email with my bank account number"],"e":"Real refunds don't ask for card details. Always check through the official customer area."},{"q":"«Your streaming subscription has been suspended. Update your card within 24 hours or lose access.»","o":["I open the official app and see if there's really a problem with my account","I update my card at the link in the email","I call the number in the email"],"e":"Short deadlines and links to «update your card» are classic phishing. The official app will tell you if there is really a problem."},{"q":"On social media, someone is selling tickets for a sold-out concert. They only accept an instant transfer and show a photo of a ticket.","o":["I don't buy: tickets only from official channels or the official resale","I buy, because they showed a photo of the ticket","I pay half now and half on the day of the concert"],"e":"Ticket photos can be fake, or the same ticket is sold to several people. Only buy from official channels."},{"q":"You get a call with your son's voice, crying: he had an accident and needs money right now. The call drops.","o":["I hang up and call my son, or someone who is with him, myself","I transfer it now, it's an emergency","I wait for him to call back and do whatever he asks"],"e":"Today a voice can be cloned from a few seconds of audio. Agree on a family password for emergencies."},{"q":"On a video call, your company director asks you for an urgent, secret transfer to a new supplier.","o":["I confirm through another channel, with the director and with accounting, before doing anything","I make the transfer: I saw him on the video call","I transfer half now to buy time"],"e":"Faces and voices can be faked with AI. Urgent, secret requests for money are always confirmed through another channel."},{"q":"A courier rings the doorbell: there's a €2 customs fee to pay and he only takes cards on his own terminal.","o":["I don't pay at the door: I check on the courier's official website","I pay, it's only €2","I hand him my card so he can swipe it"],"e":"Fake terminals copy your card or charge much more. Real fees are paid through official channels."},{"q":"You find a house to rent at a great price. The landlord is abroad and asks for the deposit by transfer before you visit.","o":["I don't pay anything without visiting the house and confirming who owns it","I pay now so I don't lose the house","I ask him to post me the keys and then I pay"],"e":"Landlords «abroad» who ask for money before a visit are a classic rental scam."},{"q":"An ad shows a famous TV host saying he got rich with an AI trading robot. They ask for €250 to get started.","o":["I ignore it: celebrities don't recommend miracle investments and the video may be fake","I invest just €250, to try it","I share it with my family so we all win"],"e":"They use celebrities' faces, often faked with AI, to sell investments that don't exist."},{"q":"After a disaster, a page asks for urgent donations to a personal bank account.","o":["I only give through well-known organisations and their official channels","I transfer now, every minute counts","I share the account number to reach more people"],"e":"Scams exploit the emotion of disasters. Real charities don't use personal accounts."},{"q":"In an online game, someone offers free coins if you give them your username and password.","o":["I don't: nobody needs my password to give me anything","I do, but I'll change the password tomorrow","I only give them my old password"],"e":"Whoever asks for your password wants to steal the account and everything in it. No game asks for that to give prizes."},{"q":"After booking accommodation, a message arrives in the booking app: «Confirm your card at this link or your booking will be cancelled.»","o":["I check directly with the property or in the official app, without tapping the link","I confirm at the link: the message came through the app","I send my card details by message"],"e":"Accommodation accounts get hacked too. Payment requests by link outside the normal process are a warning sign."}],"tm_t":"Team","tm_n":["Call-centre operator","Money mule","Lawyer"],"tm_d":["+{v} % automatic earnings per member.","+{v} % laundering capacity per member.","−{v} points on the loss when you get busted (minimum 15 %), per member."],"tm_b":"Hire ({c})","tm_lock":"Unlocks at stage {n}.","tm_now":"Now: earnings +{a} % · laundering +{l} % · getting busted costs {b} % · attention +{h} per second","tm_info":"Hire subordinates. The maximum of each type depends on your home: bigger home, bigger team. The price rises with every hire and each member draws police attention. With 2 or more, team crises may happen (one of them may defect). The team is lost when you flee to another jurisdiction.\n\n🚩 In real life, \"mules\" are people recruited to move scam money, and they are the ones who end up in prison.","tm_gone":"You lost a team member ({n}).","hc_b":"Hardcore mode","hc_on":"on","hc_off":"off","hc_info":"For those who want real risk.\n• {n} busts and the run is over: you go to prison.\n• Each bust takes {b} % of your dirty money (instead of {o} %).\n• Crises give you half the time.\n• A failed bribe adds +{h} attention.\n• Your score counts ×{x}. It only reaches the leaderboard, with a 💀 in front of your name, if you win the run.","hc_dead_t":"🚔 Arrested!","hc_dead_b":"At bust number {n} the police closed in. The run is over and it doesn't go on the leaderboard: in hardcore only winning runs count.","rat_b":"Virus active: unlocks in {n} s","cfg_g":"General","cfg_s":"Sound",