 const dirty=dirtyM(),m=sbMul(),w=[[3,"loss"],[3,"rat"],[2,"trace"],[1,"leak"],[1,"jam"]].filter(x=>(x[1]!="loss"||dirty>=1)&&(x[1]!="leak"||(S.cl||0)>=1)),T=w.reduce((a,x)=>a+x[0],0);let r0=Math.random()*T,k=w[0][1];for(const x of w){if((r0-=x[0])<0){k=x[1];break}}
