/* ===== v5.0 — ritmo da run =====
   Tudo o que se compra com dinheiro sujo (equipamento, equipa e promoção) custa PACE_F[fase atual] vezes mais (ou menos) do que a tabela base.
   É um «zoom no tempo» da fase: os ganhos não se mexem, por isso o rendimento nunca desce ao subir de fase.
   PACE_H: ajuste no Hardcore · PACE_G[fuga]: ajuste das fugas seguintes (têm mais fases e mais passaportes e não devem ficar mais curtas do que a
   primeira run; no fim da tabela, cada passaporte a mais acima de PACE_P5 encarece um pouco para as runs repetidas não encolherem). */
const PACE_F=[.72,.8,.88,1.2,2.2,2.7,3.3,3.6,3.6,3.6,3.7,3.8,3.9,3.2,2.9,1.9,1.6,.9,.9,.9],PACE_H=.93,PACE_G=[1,1.52,2.28,2.48,3.15,3.5],PACE_P5=531;
let PACE_FO=null,PACE_HO=null,PACE_GO=null;   /* só para testes (sobrepõem as constantes) */
function paceF(){const a=PACE_FO||PACE_F,i=Math.max(0,Math.min(a.length-1,(S&&S.st)|0)),h=PACE_HO==null?PACE_H:PACE_HO,g=PACE_GO||PACE_G,j=Math.min(g.length-1,(S&&S.pp)|0);
  let k=(a[i]||1)*(S&&S.hc?h:1)*(g[j]||1);
  if(j>=g.length-1&&S&&S.pass>PACE_P5)k*=Math.pow((1+.05*S.pass)/(1+.05*PACE_P5),.95);
  return k}
function paceSig(v){if(!(v>0))return 0;const e=Math.pow(10,Math.floor(Math.log10(v))-2);return Math.round(v/e)*e}   /* 3 algarismos significativos */
const stCost=i=>i>0&&ST[i]?paceSig(ST[i].cost*paceF()):0;   /* preço da promoção para a fase i, na fase atual */
