.tm55b{flex:0 0 auto;min-width:30px;padding:3px 5px}
.in55{margin:6px 0;padding:5px 6px;border:2px dashed var(--bad);background:rgba(176,0,32,.06)}
.in55 small{display:block;font-size:12px;margin-top:2px}
/* detetive, reputação, aliança, rivais */
.pd55{border-color:#777 #222 #222 #777}
.pd55 .tb{background:linear-gradient(90deg,#222,#555);color:#fff}
.pd55 button small{display:block;font-size:11px;font-weight:400;opacity:.9}
.pdp{float:right;font-size:58px;margin:0 0 4px 6px}
.rp55i{font-size:52px;flex:0 0 auto}
.rp55x{display:inline-block;margin-right:8px}
.rp55x x-i{font-size:20px;vertical-align:middle}
.rw55g{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.rw55g button{min-width:0;padding:4px 3px;line-height:1.15}
.rw55g button x-i{font-size:18px;vertical-align:middle}
.rw55g button small{display:block;font-size:11px;font-weight:400;opacity:.9}
.rw55a{text-align:center;margin:4px 0;padding:3px;background:rgba(10,107,45,.1);border:1px solid var(--ok)}
.rw55a x-i{font-size:18px;vertical-align:middle}
.ov55w{display:flex;flex-direction:column;min-height:100%;padding:10px 12px 14px;box-sizing:border-box;position:relative}
/* rusga */
.rg55 .ov55w::before{content:"";position:fixed;inset:0;background:rgba(5,8,20,.62);pointer-events:none;animation:rg55p 1s steps(2) infinite;z-index:-1}
@keyframes rg55p{0%{box-shadow:inset 0 0 90px 30px rgba(220,0,30,.55)}50%{box-shadow:inset 0 0 90px 30px rgba(0,60,230,.55)}}
html.noanim .rg55 .ov55w::before{animation:none}
.rg55h{display:flex;justify-content:space-between;align-items:center;font-size:18px;text-shadow:2px 2px 0 #000}
.rg55bar{height:12px;margin:6px 0}
.rg55d{text-align:center;text-shadow:1px 1px 0 #000;margin-bottom:4px}
.rg55door{position:absolute;right:10px;top:84px;font-size:46px;animation:rg55k .45s steps(2) infinite}
@keyframes rg55k{50%{transform:translateX(-4px) rotate(-3deg)}}
html.noanim .rg55door{animation:none}
.rg55g{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:44px auto 8px;width:100%;max-width:420px}
.rg55c{aspect-ratio:1;display:flex;align-items:center;justify-content:center}
.rg55i{width:100%;height:100%;font-size:clamp(28px,9vw,44px);padding:0;background:rgba(255,255,255,.88);transition:transform .35s ease-in,opacity .35s ease-in}
.rg55i x-i{font-size:clamp(34px,11vw,54px)}
.rg55s{text-align:center;font-size:72px;margin-top:auto}
.rg55t{font-size:clamp(70px,22vw,110px)}
.rg55s.eat{animation:rg55e .3s}
@keyframes rg55e{30%{transform:scale(1.12,.9)}70%{transform:scale(.95,1.06)}}
.rg55m{text-align:center;min-height:20px;text-shadow:1px 1px 0 #000}
.rg55q{display:block;margin:8px auto 0;background:transparent;color:#fff;border:1px solid rgba(255,255,255,.5);box-shadow:none;font-size:12px}
/* julgamento */
.jt55top{text-align:center}
.jt55j{font-size:clamp(84px,26vw,130px)}
.jt55row{display:flex;justify-content:space-between;margin-top:-30px}
.jt55p,.jt55a{font-size:clamp(70px,22vw,110px)}
.jt55c{margin-top:auto;background:rgba(10,10,20,.86);border:2px solid #c9a24a;padding:8px;line-height:1.35}
