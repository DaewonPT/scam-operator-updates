.jt55v{font-size:20px;font-weight:700;margin-bottom:4px;color:#ffe14d}
/* prisão */
.pe55h{display:flex;justify-content:space-between;font-size:18px;text-shadow:2px 2px 0 #000}
.pe55d{text-shadow:1px 1px 0 #000;margin:4px 0}
.pe55s{position:relative;height:clamp(150px,46vw,230px);margin:6px 0;border:2px solid rgba(255,255,255,.3);background:rgba(0,0,20,.25);overflow:hidden}
.pe55s.hit{box-shadow:inset 0 0 40px 10px rgba(255,0,0,.7)}
.pe55g{position:absolute;right:2%;bottom:6%;display:flex;align-items:flex-end}
.pe55g.look .pe55gd{transform:scaleX(-1)}
.pe55gd{font-size:clamp(70px,20vw,110px);position:relative}
.pe55lz{position:absolute;right:86%;bottom:2%;width:clamp(120px,40vw,220px);height:92%;background:rgba(255,236,150,.4);clip-path:polygon(100% 50%,0 8%,0 100%,100% 58%);display:none}
.pe55g.look .pe55lz{display:block}
.pe55g.warn .pe55gd{animation:rg55k .2s steps(2) infinite}
.pe55w{position:absolute;top:-26px;left:38%;font-size:26px;display:none}
.pe55g.warn .pe55w,.pe55g.look .pe55w{display:block}
.pe55g.look .pe55w{color:#ff5050}
.pe55o{position:absolute;left:4%;bottom:6%;transition:left .1s linear}
.pe55op{font-size:clamp(64px,19vw,100px)}
