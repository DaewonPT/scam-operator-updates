/* v5.2 — temas da janela (o alto contraste continua a mandar: os temas não se aplicam com .hico) */
:root[data-theme="noite"]:not(.hico){--desk:#0b3b3b;--win:#3a3a3f;--fg:#f0f0f0;--tb:#3b3bb5;--hi:#5a5a62;--lo:#16161a;--in:#1b1b20;--warn:#ffe14d;--bad:#ff6b81;--ok:#4cd987}
:root[data-theme="w98"]:not(.hico){--desk:#3a6ea5;--win:#d4d0c8;--fg:#111;--tb:#0a246a;--hi:#fff;--lo:#808080;--in:#fff;--warn:#ffe14d;--bad:#b00020;--ok:#0a6b2d}
:root[data-theme="w98"]:not(.hico) .tb{background:linear-gradient(90deg,#0a246a,#a6caf0)}
:root[data-theme="hacker"]:not(.hico){--desk:#000;--win:#0b140b;--fg:#33ff66;--tb:#003b12;--hi:#1f6b2f;--lo:#020602;--in:#000;--warn:#33ff66;--bad:#ff5f5f;--ok:#7dff9a}
:root[data-theme="hacker"]:not(.hico) body,:root[data-theme="hacker"]:not(.hico) button,:root[data-theme="hacker"]:not(.hico) select,:root[data-theme="hacker"]:not(.hico) input{font-family:"Courier New",Consolas,"Liberation Mono",monospace}
:root[data-theme="hacker"]:not(.hico) .tb{color:#7dff9a}
:root[data-theme="vapor"]:not(.hico){--desk:#2b1055;--win:#ffd6f5;--fg:#2b1055;--tb:#ff3fa4;--hi:#fff;--lo:#9b5de5;--in:#fff0fb;--warn:#00f5d4;--bad:#d90429;--ok:#007f5f}
:root[data-theme="vapor"]:not(.hico) body{background:linear-gradient(180deg,#2b1055 0%,#7b2ff7 65%,#ff3fa4 100%) fixed}
:root[data-theme="vapor"]:not(.hico) .tb{background:linear-gradient(90deg,#ff3fa4,#7b2ff7)}
:root[data-theme="abobora"]:not(.hico){--desk:#1a0f2e;--win:#2b2236;--fg:#ffe8cc;--tb:#ff7518;--hi:#5a4a6a;--lo:#0d0814;--in:#140d1f;--warn:#ff9f1c;--bad:#ff5d5d;--ok:#9be564}
:root[data-theme="abobora"]:not(.hico) .tb{color:#1a0f2e}
:root[data-theme="bf"]:not(.hico){--desk:#0a0a0a;--win:#1c1c1c;--fg:#f5f5f5;--tb:#c9a227;--hi:#444;--lo:#000;--in:#111;--warn:#ffd23f;--bad:#ff3b3b;--ok:#3ddc84}
:root[data-theme="bf"]:not(.hico) .tb{color:#111}
:root[data-theme="natal"]:not(.hico){--desk:#0f5132;--win:#f8f4ec;--fg:#1b1b1b;--tb:#b3261e;--hi:#fff;--lo:#7a6a55;--in:#fff;--warn:#ffd166;--bad:#b3261e;--ok:#0f7a3c}
.thg{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:5px;margin:6px 0 4px}
.thg button{display:flex;align-items:center;gap:6px;text-align:left;padding:4px 6px;min-height:40px;font-size:13px;line-height:1.2}
.thg button.on{border-color:var(--lo) var(--hi) var(--hi) var(--lo);background:var(--warn);color:#111;font-weight:700}
.thg button span{flex:1;min-width:0}.thg button small{display:block;font-size:10px;opacity:.85;font-weight:400}
.thg i.thsw{flex:0 0 26px;width:26px;height:22px;border:1px solid #000;display:flex;align-items:flex-end;justify-content:center;box-sizing:border-box}
.thg i.thsw i{display:block;width:14px;height:8px;margin-bottom:2px;border:1px solid #0006}
/* v5.2 — eventos de época: cartão na aba Trabalho e decoração */
.evc{margin:6px 0;padding:6px 8px;border:2px dashed var(--lo);background:var(--in)}
.evc .evi{flex:0 0 auto;font-size:28px;line-height:1}
.evc small{display:block;opacity:.85;font-size:11px}
.evc.ev-hw{border-color:#ff7518}.evc.ev-bf{border-color:#c9a227}.evc.ev-xm{border-color:#b3261e}
body.ev-hw #sc::after,body.ev-bf #sc::after,body.ev-xm #sc::after,body.ev-hw .hsimg::after,body.ev-bf .hsimg::after,body.ev-xm .hsimg::after{position:absolute;left:0;right:0;top:2px;z-index:4;text-align:center;font-size:16px;line-height:1.2;letter-spacing:6px;white-space:nowrap;overflow:hidden;pointer-events:none;text-shadow:0 1px 2px #000a}
body.ev-hw #sc::after,body.ev-hw .hsimg::after{content:"🎃 🦇 🕸️ 👻 🍬 🎃 🦇 🕸️ 👻 🍬"}
body.ev-bf #sc::after,body.ev-bf .hsimg::after{content:"🏷️ 🛍️ 💳 📦 % 🏷️ 🛍️ 💳 📦 %"}
body.ev-xm #sc::after,body.ev-xm .hsimg::after{content:"🎄 ❄️ 🎁 ⭐ 🦌 🎄 ❄️ 🎁 ⭐ 🦌"}
/* v5.2 — configurações mais limpas: título por separador, interruptores grandes ✓/✗, separadores em baixo */
.cfg5{display:flex;flex-direction:column;min-height:calc(100vh - 22px - env(safe-area-inset-top,0px));margin-bottom:0}
.cfg5>.b{flex:1;padding:10px 12px 12px}
.cfg5 .cfh{display:flex;align-items:center;justify-content:center;gap:8px;margin:2px 0 12px;font-size:20px;font-weight:700;text-align:center}
.cfg5 .cfh x-i.sp{font-size:26px}
.cfg5 p{margin:6px 0}
.cfg5 .cfl{margin:12px 0 4px;font-weight:700}
.cfg5 .cff{display:flex;flex-wrap:wrap;gap:4px}
.cfg5 .cff .lang-btn{flex:1 0 12%;min-width:42px;margin:0;padding:4px 2px}
.cfg5 .lang-btn.on{border-color:var(--lo) var(--hi) var(--hi) var(--lo);background:var(--warn)}
.cfg5 label.tgl{display:flex;align-items:center;gap:8px;width:100%;min-height:46px;padding:7px 10px;background:var(--win);color:var(--fg);border:2px solid;border-color:var(--hi) var(--lo) var(--lo) var(--hi);box-shadow:2px 2px 0 #0004;cursor:pointer;font-weight:600;line-height:1.25;-webkit-tap-highlight-color:transparent}
.cfg5 label.tgl:active{border-color:var(--lo) var(--hi) var(--hi) var(--lo);box-shadow:none}
.cfg5 label.tgl input{-webkit-appearance:none;appearance:none;flex:0 0 28px;width:28px;height:28px;margin:0 2px 0 0;border:2px solid #111;border-radius:3px;background:#e9e9e9;display:grid;place-items:center;cursor:pointer}
.cfg5 label.tgl input::before{content:"✕";font:900 16px/1 Tahoma,Verdana,sans-serif;color:#b00020}
.cfg5 label.tgl input:checked{background:#1f9d4c}
.cfg5 label.tgl input:checked::before{content:"✓";color:#fff;font-size:19px}
.cfg5 label.tgl x-i.sp{font-size:20px}
.cfg5 label.tgl+br{display:none}
.cfg5 label.tgl~small{display:block;margin:3px 2px 0}
.cfg5 p.tgp{display:flex;align-items:center;gap:6px}.cfg5 p.tgp>label.tgl{flex:1}
.cfg5 .cfn{display:flex;align-items:center;gap:8px;width:100%;min-height:46px;margin:6px 0;padding:7px 10px;text-align:left;font-weight:600;text-decoration:none;color:var(--fg);background:var(--win);border:2px solid;border-color:var(--hi) var(--lo) var(--lo) var(--hi);box-shadow:2px 2px 0 #0004;box-sizing:border-box}
.cfg5 .cfn:active{border-color:var(--lo) var(--hi) var(--hi) var(--lo);box-shadow:none}
.cfg5 .cfn span{flex:1;min-width:0}.cfg5 .cfn small{font-weight:400;opacity:.8;font-size:12px}.cfg5 .cfn b{font-size:22px;line-height:1}
.cfg5 .cfdel{width:100%;min-height:44px;color:var(--bad);font-weight:700}
.cfg5 .cfa{min-height:30px;padding:3px 10px;font-size:12px}
.cfg5 .sl5{display:flex;align-items:center;gap:10px;margin:8px 2px 10px}
.cfg5 .sl5>span{flex:0 0 30px;font-size:22px;text-align:center}.cfg5 .sl5 x-i.sp{font-size:24px}
.cfg5 .sl5 input[type=range]{flex:1;min-width:0;height:28px;accent-color:var(--tb)}
.cfg5 .sl5 b{flex:0 0 34px;text-align:right;font-size:13px}
.cfg5 .cft{position:sticky;bottom:-10px;z-index:4;display:flex;gap:4px;padding:6px 6px calc(16px + env(safe-area-inset-bottom,0px));background:var(--win);border-top:2px solid var(--lo);box-shadow:0 -3px 6px #0003}
.cfg5 .cft button{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:54px;padding:4px 2px;font-size:11px;line-height:1.15}
.cfg5 .cft button x-i.sp{font-size:22px}
.cfg5 .cft button.on{border-color:var(--lo) var(--hi) var(--hi) var(--lo);background:var(--warn);color:#111;font-weight:700}
.cfg5 .svs{border:2px solid var(--lo);background:var(--in);padding:8px;margin:0 0 8px}
.cfg5 .svs.cur{border-color:var(--tb);box-shadow:inset 4px 0 0 var(--tb)}
.cfg5 .svs .svi{font-size:13px;margin:3px 0 6px}.cfg5 .svs .svi small{display:block;opacity:.75}
.cfg5 .svs .svb{gap:6px}.cfg5 .svs .svb button{min-height:40px;padding:4px 6px}.cfg5 .svs .svb .svd{flex:0 0 46px;color:var(--bad)}
